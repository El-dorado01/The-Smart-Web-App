    function createTopicImg(id) {
        var field = document.getElementById("field_" + id);

        //Count Number of images
        if (field.querySelector(".preview .sub-img")) {
            var imgNo = field.querySelectorAll(".preview .sub-img").length;
        } else {
            var imgNo = 0;
        }

        if (field.querySelector(".preview .sub-video")) {
            // Can't select more than a video
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select a video with images";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else if (imgNo > 2) {
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select more than two images";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else {
            var remainder = 2 - imgNo;
            let randID = Math.random() * 10;

            var img = document.createElement("input");
            img.setAttribute("type", "file");
            img.setAttribute("onchange", "showTopicImg(this, " + id + ")");
            img.className = remainder;
            img.setAttribute("style", "display: none;");
            img.accept = "image/*";
            img.id = randID;
            img.multiple = true;

            field.appendChild(img);
            // field.querySelector(".preview").appendChild(div)

            var image = document.getElementById(randID);

            image.click();
        }
    }

    function showTopicImg(image, fieldID) {
        var abc = "fileArray_" + fieldID;

        var remainder = parseInt(image.className);
        if (image.files.length > 0 && image.files.length <= remainder) {
            var field = document.getElementById("field_" +
                fieldID);
            for (let i = 0; i < image.files.length; i++) {
                let randID = Math.random() * 10;
                var
                    div = document.createElement("div");
                div.className = "sub-img";
                div.setAttribute("style", "display: none;");
                div.id = "topicImgPreview_" + randID;
                div.innerHTML = ` <span onclick="removeTopicImg('${randID}', '${fieldID}')"><i
            class="fa fa-times"></i></span>
        <img src="" alt="">
        `;

                if (image.files[i].size > 7000000) {
                    dangerAlert.style.display = "block";
                    dangerMessage.textContent = "File size is too big";

                    setTimeout(() => {
                        dangerAlert.style.display = "none";
                    }, 5000);
                } else {
                    var obj = {
                        id: randID,
                        file: image.files[i],
                    };

                    topicImgFilesObj[abc].push(obj);

                    field.querySelector(".preview").appendChild(div);

                    var src = URL.createObjectURL(image.files[i]);
                    var preview = document.getElementById("topicImgPreview_" + randID);
                    preview.style.display = "block";
                    preview.querySelector("img").src = src;
                }
            }
        } else {
            if (image.files.length < 1) {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You didn't select any image file";
                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            } else {
                //Can't select more than 2
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You can't select more than two images";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            }
        }
    }

    function removeTopicImg(id, inputID) {
        var abc = "fileArray_" + inputID;

        for (var i = 0; i < topicImgFilesObj[abc].length; i++) {
            if (topicImgFilesObj[abc][i].id.toString() === id) {
                topicImgFilesObj[abc].splice(i, 1);
            }
        }
        document.getElementById("topicImgPreview_" + id).remove();
    }

    function
    createTopicVideo(id) {
        var field = document.getElementById("field_" + id);
        if (field.querySelector(".preview .sub-img")) { // Can't select a video with images
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select a video with images";
            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else if (field.querySelector(".preview .sub-video")) {
            // var imgNo = field.querySelectorAll(".preview .sub-img").length;
            // Can't select more than a video
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select more than a video";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else {
            // var remainder = 4 - imgNo;
            let randID = Math.random() * 10;

            var video = document.createElement("input");
            video.setAttribute("type", "file");
            video.setAttribute("onchange", "showTopicVideo(this, " + id + ")");
            video.setAttribute("style", "display: none;");
            video.accept = "video/*";
            video.id = randID;

            field.appendChild(video);

            var videoInput = document.getElementById(randID);

            videoInput.click();
        }
    }

    function showTopicVideo(video, fieldID) {
        var abc = "fileArray_" + fieldID;
        let randID = Math.random() * 10;
        var id = video.id;
        // var remainder = parseInt(video.className);
        if (video.files.length > 0) {
            var field = document.getElementById("field_" + fieldID);

            div = document.createElement("div");
            div.className = "sub-video";
            div.setAttribute("style", "display: none;");
            div.id = "videoPreview_" + randID;
            div.innerHTML = ` <span onclick="removeTopicVideo('${randID}', '${fieldID}')"><i
                        class="fa fa-times"></i></span>
                <video src="" controls></video>
                `;

            if (video.files[0].size > 10000000) {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "Video file size is too big";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            } else {
                field.querySelector(".preview").appendChild(div);

                // var duration;
                var src = URL.createObjectURL(video.files[0]);
                var preview = document.getElementById("videoPreview_" + randID);
                preview.style.display = "block";
                preview.querySelector("video").src = src;

                var obj = {
                    id: randID,
                    file: video.files[0],
                };

                topicVideoFilesObj[abc].push(obj);
            }

            //Delete the input type file
            document.getElementById(id).remove();
        } else {
            //Can't select more than 4
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "No video file has been selected";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        }
    }

    function removeTopicVideo(id, inputID) {
        var abc = "fileArray_" + inputID;

        for (var i = 0; i < topicVideoFilesObj[abc].length; i++) {
            if (topicVideoFilesObj[abc][i].id.toString() === id) {
                topicVideoFilesObj[abc].splice(i, 1);
            }
        }
        document.getElementById("videoPreview_" + id).remove();
    }

    var tagInput = document.getElementById("tag-value")

    tagInput.addEventListener("keypress", function (event) {
        if (event.key === "Enter") {
            event.preventDefault()

            var valuesArray = tagInput.value.split(",")
            var allTags = document.querySelectorAll(".field .word-tags .up div")
            var allowedNumberOfTags = 5 - allTags.length

            if (valuesArray.length <= allowedNumberOfTags) {
                for (let i = 0; i < valuesArray.length; i++) {
                    var div = document.createElement("div");
                    div.classList.add("tag")
                    div.classList.add(valuesArray[i])
                    div.innerHTML =
                        ` <span class="remove-tag"
                                onclick="removeTagWord('${valuesArray[i]}')">
                                <i class="fa-solid fa-times"></i>
                                </span>
                                <p>${valuesArray[i]}</p>
                            `
                    document.querySelector(".field .word-tags .up").appendChild(div)
                }
                tagInput.value = ""
            } else {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You can't enter more than five tags for your topic!";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            }

        }
    })

    function removeTagWord(obj) {
        document.querySelector(".tag." + obj).remove()
    }
