<div class="messages" style="display: block;">
    <div class="heading" id="forum-heading" onclick="closeTag()" style="margin-bottom: 0.3rem;">
        <div style="display:flex;">
            <h4 style="margin-right: 10px;">Forums</h4>
            <i class="fa fa-users-rays"></i>
        </div>
        <i class="fa fa-angle-down angle1"
            style="display: none; font-size: 18px; padding-right: 10px; cursor: pointer;"></i>
        <i class="fa fa-angle-left angle2" style="font-size: 18px; padding-right: 10px; cursor: pointer;"></i>
    </div>
    <div id="close-forums">
        <div class="category">
            <h6 class="active tablinks" class="archive" onclick="openTab(event, 'my-forums-middle')" id="defaultOpen">My
                Forums
                &nbsp; <i class="fa-solid fa-users-rays" style="font-size: 1rem;"></i> <span class="msg-archive">
                    <%= forums.length %>
                </span>
            </h6>
            <h6 class="tablinks" onclick="openTab(event, 'forum-invites-middle')" style="font-size: 1rem;">
                Invites &nbsp; <i class="fa-solid fa-envelope-open-text"></i>
                <span class="msg-archive">0</span>
            </h6>
        </div>
        <div class="postFeeds" id="my-forums-middle">
            <!--Search Bar-->
            <div class="search-bar2">
                <i class="fa fa-search"></i>
                <input type="search" placeholder="Search" id="message-search">
            </div>
            <div class="scroll-bar">
                <% forums.forEach(forum => { 
                    if(forum._id == forumID){%>
                        <div class="message">
                            <a href="/dashboard/public/forum/<%= forum._id %>">
                                <div class="profile-pic">
                                    <img src="<%= forum.displayPic %>" alt="">
                                </div>
                            </a>
                            <div class="message-body">
                                <a href="/dashboard/public/forum/<%= forum._id %>">
                                    <h5 style="font-size: 13px; font-weight: 600; color: var(--color-primary)"><%= forum.forumName %></h5>
                                </a>
                                <p class="text-muted">
                                    <%= forum.members.length + 1 %>
                                    member<% if (forum.members.length > 1){%>s<%}%>
                                </p>
                            </div>
                        </div>
                    <% }
                 })  
                 forums.forEach(forum=> {
                    if(forum._id != forumID){ %>
                        <div class="message">
                            <a href="/dashboard/public/forum/<%= forum._id %>">
                                <div class="profile-pic">
                                    <img src="<%= forum.displayPic %>" alt="">
                                </div>
                            </a>
                            <div class="message-body">
                                <a href="/dashboard/public/forum/<%= forum._id %>">
                                    <h5 style="font-size: 13px; font-weight: 600;"><%= forum.forumName %></h5>
                                </a>
                                <p class="text-muted">
                                    <%= forum.members.length + 1 %>
                                    member<% if (forum.members.length > 1){%>s<%}%>
                                </p>
                            </div>
                        </div>
                    <% } 
                }) %>
            </div>
            <button class="btn btn-primary" style="margin-top: 10px;" onclick="showCreateForum()">
                <span class="fa fa-plus"></span>
                Create a Forum
            </button>
        </div>
        <div class="postFeeds" id="forum-invites-middle">
            <% if (invites.length < 1) { %>
                <div class="body">
                    <span class="text-muted">You have no invites</span>
                </div>
                <% } else { %>
                    <div class="scroll-bar">
                        <div class="messages">
                            <% invites.forEach(invite=> { %>
                                <div class="forum">
                                    <div class="info">
                                        <div class="profile-pic">
                                            <img src="<%= invite.displayPic %>" alt="">
                                        </div>
                                        <div class="message-body">
                                            <h5 style="font-size: 13px; font-weight: 600;">
                                                <%= invite.forumName %>
                                            </h5>
                                            <p class="text-muted">
                                                <%= invite.members.length %>
                                                    member<% if(invite.members.length> 1){%>s<%}%>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="action">
                                        <span onclick="updateInvite('<%= invite._id %>', '<%= userID %>', 'accept')"><i
                                                class="fa-solid fa-check"></i></span>
                                        <span onclick="updateInvite('<%= invite._id %>', '<%= userID %>', 'reject')"><i
                                                class="fa-solid fa-times"></i></span>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                    <% } %>
        </div>
    </div>
</div>