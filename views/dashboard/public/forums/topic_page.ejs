<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Header -->
    <%- include("../partials/header") %>
</head>

<body>
    <!-- NavBar -->
    <%- include ("../partials/navBar") %>

        <!--Main-->
        <main>
            <div class="container">
                <div class="alerts">
                    <div class="alert-primary" id="alert-primary" style="display: none;">
                        <span class="fa fa-times"></span>
                        <div class="body">
                            <i class="fa-solid fa-spinner"></i>
                            <p class="msg"></p>
                        </div>
                    </div>
                    <div class="alert-success" id="alert-success" style="display: none;">
                        <span class="fa fa-times"></span>
                        <div class="body">
                            <i class="fa fa-check-circle"></i>
                            <p class="msg"></p>
                        </div>
                    </div>
                    <div class="alert-danger" id="alert-danger" style="display: none;">
                        <span class="fa fa-times"></span>
                        <div class="body">
                            <i class="fa fa-exclamation-circle"></i>
                            <p class="msg"></p>
                        </div>
                    </div>
                </div>
                <!-- Sidebar -->
                <%- include ("../partials/sidebar") %>

                    <!--Middle-->
                    <div class="middle">
                        <!--Forums-->
                        <%- include ("./my_forums_middle") %>
                            <%- include ("./create_forum") %>
                                <div class="forum-profile">
                                    <div class="forum-header">
                                        <div class="avatar"
                                            onclick='document.querySelector(".forum-profile .settings").style.display = "none";'>
                                            <img src="" alt="" id="forum-avatar">
                                        </div>
                                        <div class="info">
                                            <h3
                                                onclick='document.querySelector(".forum-profile .settings").style.display = "none"; '>
                                            </h3>
                                            <p class="forum-desc"></p>
                                            <p class="name" style="margin-top: 5px;">
                                                <span style="padding: 5px; background-color: var(--color-light);"><i
                                                        class="fa fa-users-rays"></i> <span
                                                        class="forum-member"></span></span>
                                            </p>
                                            <div class="action-icons">
                                                <% if(isAMember==false){ %>
                                                    <div title="Send Request to Join Forum"
                                                        <% if(thereIsRequest == true){ %>
                                                            style="width: 100%; background-color: var(--color-danger);"
                                                            class="btn"
                                                            onclick="cancelRequestToJoin(this, '<%= forumID %>', 'rejectInvites')"
                                                        <% }else{ %>
                                                            style="width: 100%;"
                                                            class="btn btn-primary"
                                                            onclick="sendRequestToJoin(this, '<%= forumID %>', 'sendRequestToJoin')"
                                                        <% } %>>
                                                        <% if(thereIsRequest == true){ %>
                                                            <i class="fa-solid fa-user-times"></i> <span>Cancel Request</span>
                                                        <% }else{ %>
                                                            <i class="fa-solid fa-person-circle-plus"></i> <span>Request to Join</span>
                                                        <% } %>
                                                    </div>
                                                    <% }else{ %>
                                                        <div class="btn btn-primary"
                                                            onclick="document.querySelector('.add-topic-modal').style.display = 'grid';"
                                                            title="Add a new topic">
                                                            <i class="fa-solid fa-plus"></i> <span>Add</span>
                                                        </div>
                                                        <div class="other-icons">
                                                            <% if(userNotificationStatus){
                                                                var subscriptionObjects = JSON.stringify(userNotificationStatus.pushNotifications);
                                                            %>
                                                                <span onclick="notificationsPanel('<%= forumID %>', '<%= user._id %>', <%= userNotificationStatus.enablePushNotifications %>, <%= subscriptionObjects %>, '<%= userNotificationStatus.subscriptionType %>')" title="Turn off notifications"><i
                                                                        class="fa fa-bell"></i></span>
                                                            <% }else{ %>
                                                                <span onclick="notificationsPanel('<%= forumID %>', '<%= user._id %>', false, 'subscriptionObject')" title="Turn on notifications"><i
                                                                        class="fa fa-bell"></i></span>
                                                            <% } %>
                                                            <% if(forumInfo.membersCanInvite==true && isAMember==true &&
                                                                isAModerator==false){ %>
                                                                <span
                                                                    onclick="copyForumInviteLink('<%= forumInfo.forumSecretKey %>', '<%= forumID %>', '<%= getURL %>/dashboard/public/forum_invites/<%= forumID %>/key?secretKey=')"
                                                                    title="Copy Invite Link"><i
                                                                        class="fa-solid fa-link"></i></span>
                                                                <% } %>
                                                                    <% if(isAModerator==true){ %>
                                                                        <span onclick="toggleSettingsTwo()"
                                                                            title="Toggle to show and hide settings"><i
                                                                                class="fa fa-cog"></i></span>
                                                                        <% } %>
                                                                            <span title="Exit Forum"><i
                                                                                    class="fa-solid fa-sign-out"></i></span>
                                                        </div>
                                                        <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <%- include ("./forum_settings") %>
                                        <div class="forum-body">
                                            <div class="topic-title">
                                                <div class="first">
                                                    <div class="title">
                                                        <%= topicInfo.subject %>
                                                    </div>
                                                </div>
                                                <div class="tags-panel">
                                                    <div class="tags">
                                                        <% topicInfo.topicTags.forEach(tag=> {%>
                                                            <a
                                                                href="/dashboard/public/forum_topic_categories/<%= tag %>/key?forumID=<%= forumID %>">
                                                                <div class="tag">
                                                                    <i class="fa-solid fa-tag"></i>
                                                                    <span>
                                                                        <%= tag %>
                                                                    </span>
                                                                </div>
                                                            </a>
                                                            <%})%>
                                                    </div>
                                                    <div class="action">
                                                        <div title="Views">
                                                            <span><i class="fa-solid fa-eye fa-lg"></i></span>
                                                            <span class="count">
                                                                <%= topicInfo.__v %>
                                                            </span>
                                                        </div>
                                                        <div title="Comments">
                                                            <span><i class="fa-solid fa-comment fa-lg"></i></span>
                                                            <span class="count" id="comment-count">
                                                                <%= responses.length %>
                                                            </span>
                                                        </div>
                                                        <% if(topicInfo.pinned==true){%>
                                                            <div title="Unpin Discussion" id="pinDiscussion"
                                                                onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'unpinDiscussion', <%= isAModerator %>)"
                                                                style="cursor: pointer;">
                                                                <span style="color: var(--color-primary);"><i
                                                                        class="fa-solid fa-thumbtack fa-lg"></i></span>
                                                            </div>
                                                            <% }else{ %>
                                                                <div title="Pin Discussion" id="pinDiscussion"
                                                                    onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'pinDiscussion', <%= isAModerator %>)"
                                                                    style="cursor: pointer;">
                                                                    <span><i
                                                                            class="fa-solid fa-thumbtack fa-lg"></i></span>
                                                                </div>
                                                                <% } %>

                                                                    <% if(topicInfo.discussionClosed==true){%>
                                                                        <div title="Open Discussion"
                                                                            onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'openDiscussion', <%= isAModerator %>)"
                                                                            id="closeDiscussion"
                                                                            style="cursor: pointer;">
                                                                            <span
                                                                                style="color: var(--color-primary);"><i
                                                                                    class="fa-solid fa-comment-slash fa-lg"></i></span>
                                                                        </div>
                                                                        <% }else{ %>
                                                                            <div title="Close Discussion"
                                                                                onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'closeDiscussion', <%= isAModerator %>)"
                                                                                id="closeDiscussion"
                                                                                style="cursor: pointer;">
                                                                                <span><i
                                                                                        class="fa-solid fa-comment-slash fa-lg"></i></span>
                                                                            </div>
                                                                            <% } %>
                                                    </div>
                                                </div>
                                                <div class="second">
                                                    <div class="user-info">
                                                        <a
                                                            href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                                                            <img src="../../../../uploads/<%= questionnaire.userInfo.avatar %>"
                                                                alt="">
                                                        </a>
                                                        <div>
                                                            <h5>By <a
                                                                    href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                                                                    <%= questionnaire.userInfo.username %>
                                                                </a>,</h5>
                                                            <span class="text-muted">
                                                                <%= questionnaire.memberUpvotes %>
                                                                    upvote<% if(questionnaire.memberUpvotes> 1){%>s<% }
                                                                            %>,
                                                                            <%= new
                                                                                Date(topicInfo.createdAt).toDateString()
                                                                                %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="action">
                                                        <% if(bookmarked==true){%>
                                                            <div class="flex"
                                                                title="Remove this Discussion from Bookmarks"
                                                                style="cursor: pointer;"
                                                                onclick="updateTopicBookmarks(this, '<%= user._id%>','<%= topicInfo._id %>','<%= topicInfo.forumID %>','removeTopicFromBookmarks', <%= isAMember %>)">
                                                                <span class="icon"
                                                                    style="color: var(--color-primary);"><i
                                                                        class="fa-solid fa-bookmark fa-lg"></i>
                                                                </span>&nbsp;
                                                                <div class="count">
                                                                    <%= topicInfo.bookmarks.length %>
                                                                </div>
                                                            </div>
                                                            <%}else{%>
                                                                <div class="flex" title="Bookmark this Discussion"
                                                                    style="cursor: pointer;"
                                                                    onclick="updateTopicBookmarks(this, '<%= user._id%>','<%= topicInfo._id %>','<%= topicInfo.forumID %>','bookmarkATopic', <%= isAMember %>)">
                                                                    <span class="icon"><i
                                                                            class="fa-solid fa-bookmark fa-lg"></i>
                                                                    </span>&nbsp;
                                                                    <div class="count">
                                                                        <%= topicInfo.bookmarks.length %>
                                                                    </div>
                                                                </div>
                                                                <%} if(topicUpvotedByUser==true){%>
                                                                    <div class="flex"
                                                                        title="Remove this Topic from Upvotes"
                                                                        style="cursor: pointer;"
                                                                        onclick="updateTopicUpvotes(this, '<%= user._id%>','<%= topicInfo._id %>','<%= topicInfo.forumID %>','removeTopicFromUpvotes', <%= isAMember %>, '<%= topicInfo.userID %>')">
                                                                        <span class="icon"
                                                                            style="color: var(--color-primary);"><i
                                                                                class="fa-solid fa-circle-up fa-lg"></i>
                                                                        </span>&nbsp;
                                                                        <div class="count">
                                                                            <%= topicInfo.upvotes %>
                                                                        </div>
                                                                    </div>
                                                                    <%}else{%>
                                                                        <div class="flex" title="Upvote this Topic"
                                                                            style="cursor: pointer;"
                                                                            onclick="updateTopicUpvotes(this, '<%= user._id%>','<%= topicInfo._id %>','<%= topicInfo.forumID %>','upvoteATopic', <%= isAMember %>, '<%= topicInfo.userID %>')">
                                                                            <span class="icon"><i
                                                                                    class="fa-solid fa-circle-up fa-lg"></i>
                                                                            </span>&nbsp;
                                                                            <div class="count">
                                                                                <%= topicInfo.upvotes %>
                                                                            </div>
                                                                        </div>
                                                                        <%} %>
                                                                            <div title="Share" class="extra">
                                                                                <span><i
                                                                                        class="fa-solid fa-arrow-up-from-bracket fa-lg"></i></span>
                                                                            </div>
                                                                            <% if(isAMember==true){
                                                                                if(user._id==topicInfo.userID){ %>
                                                                                <div title="Delete Topic" class="extra"
                                                                                    style="background-color: var(--color-danger);"
                                                                                    onclick="deleteResponseInForum('<%= topicInfo._id %>','<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= topicInfo.userID %>','topicDelete')">
                                                                                    <span><i
                                                                                            class="fa-solid fa-trash fa-lg"></i></span>
                                                                                </div>
                                                                                <% } else
                                                                                    if(topicInfo.userID==forumInfo.creator)
                                                                                    { %>
                                                                                    <% } else
                                                                                        if(user._id==forumInfo.creator)
                                                                                        { for (let i=0; i <
                                                                                        forumInfo.members.length; i++) {
                                                                                        if(forumInfo.members[i].userID==topicInfo.userID){
                                                                                        if(forumInfo.members[i].memberStatus=="inactive"
                                                                                        ||
                                                                                        forumInfo.members[i].memberStatus=="ejected"
                                                                                        ) {%>
                                                                                        <div title="Delete Topic"
                                                                                            class="extra"
                                                                                            style="background-color: var(--color-danger);"
                                                                                            onclick="deleteResponseInForum('<%= topicInfo._id %>','<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= topicInfo.userID %>','topicDelete')">
                                                                                            <span><i
                                                                                                    class="fa-solid fa-trash fa-lg"></i></span>
                                                                                        </div>
                                                                                        <% } else { %>
                                                                                            <div style="position: relative;"
                                                                                                id="other-actions-<%= topicInfo._id %>"
                                                                                                class="moreDiv">
                                                                                                <span class="extra"
                                                                                                    title="More"
                                                                                                    onclick="showOtherActionsInForum('<%= topicInfo._id %>', '<%= topicInfo.forumID %>', '<%= topicInfo.userID %>', '<%= topicInfo._id %>', 'topicDelete')"><i
                                                                                                        class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                                                            </div>
                                                                                            <% } } } } else { for (let
                                                                                                i=0; i <
                                                                                                forumInfo.moderators.length;
                                                                                                i++) {
                                                                                                if(forumInfo.moderators[i].userID==user._id)
                                                                                                { for (let i=0; i <
                                                                                                forumInfo.members.length;
                                                                                                i++) {
                                                                                                if(forumInfo.members[i].userID==topicInfo.userID){
                                                                                                if(forumInfo.members[i].memberStatus=="inactive"
                                                                                                ||
                                                                                                forumInfo.members[i].memberStatus=="ejected"
                                                                                                ) {%>
                                                                                                <div title="Delete Topic"
                                                                                                    class="extra"
                                                                                                    style="background-color: var(--color-danger);"
                                                                                                    onclick="deleteResponseInForum('<%= topicInfo._id %>','<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= topicInfo.userID %>','topicDelete')">
                                                                                                    <span><i
                                                                                                            class="fa-solid fa-trash fa-lg"></i></span>
                                                                                                </div>
                                                                                                <% }else{ %>
                                                                                                    <div style="position: relative;"
                                                                                                        id="other-actions-<%= topicInfo._id %>"
                                                                                                        class="moreDiv">
                                                                                                        <span
                                                                                                            class="extra"
                                                                                                            title="More"
                                                                                                            onclick="showOtherActionsInForum('<%= topicInfo._id %>', '<%= topicInfo.forumID %>', '<%= topicInfo.userID %>', '<%= topicInfo._id %>', 'topicDelete')"><i
                                                                                                                class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                                                                    </div>
                                                                                                    <% } } } } } } }%>
                                                    </div>
                                                </div>
                                            </div>
                                            <!--Questionnaire-->
                                            <div class="q-box" id="<%= topicInfo._id %>"
                                                style="box-shadow: 0 0 0.5rem var(--color-primary); margin-bottom: 2.5rem;">
                                                <div class="q-box-main">
                                                    <div class="q-box-left">
                                                        <div class="user-info">
                                                            <a
                                                                href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                                                                <h4>
                                                                    <%= questionnaire.userInfo.username %>
                                                                </h4>
                                                            </a>
                                                            <a
                                                                href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                                                                <img src="../../../../uploads/<%= questionnaire.userInfo.avatar %>"
                                                                    alt="">
                                                            </a>
                                                            <div class="upvotes">
                                                                <%= questionnaire.memberUpvotes %>
                                                                    upvote<% if(questionnaire.memberUpvotes> 1){%>s<% }
                                                                            %>
                                                            </div>
                                                            <span>Posted: <i class="text-muted">
                                                                    <%= new Date(topicInfo.createdAt).toDateString() %>
                                                                </i></span>
                                                        </div>
                                                    </div>
                                                    <div class="q-box-right" id="field_<%= topicInfo._id %>">
                                                        <div class="field-one">
                                                            <div class="response-field">
                                                                <%- topicInfo.topicText %>
                                                            </div>
                                                            <!-- Topic Media -->
                                                            <% if(topicInfo.topicMedia.length> 0){%>
                                                                <div class="media">
                                                                    <% var imagesExtensions=["jpg", "gif" , "png" ]; var
                                                                        videosExtensions=["mp4", "3gp" , "ogg" ];
                                                                        topicInfo.topicMedia.forEach(media=> {
                                                                        var url = new URL(media)
                                                                        var extension = url.pathname.split(".")[1]

                                                                        if (imagesExtensions.includes(extension)) {
                                                                        %>
                                                                        <div class="img">
                                                                            <img id="forumImg" src="<%= url %>" alt="">
                                                                        </div>
                                                                        <% } else if
                                                                            (videosExtensions.includes(extension)) { %>
                                                                            <div class="video">
                                                                                <video controls>
                                                                                    <source src="<%= url %>"
                                                                                        type="video/<%= extension %>">
                                                                                </video>
                                                                            </div>
                                                                            <% } }); %>
                                                                </div>
                                                                <% } %>
                                                        </div>
                                                        <div class="actions">
                                                            <span title="Quote"
                                                                onclick="tagAResponse('<%= topicInfo.forumID %>', '<%= topicInfo._id %>', '<%= topicInfo._id %>', '<%= JSON.stringify(forumInfo.wordsFilter) %>', <%= isAMember %>)">
                                                                <i class="fa-solid fa-quote-right fa-lg"></i>
                                                            </span>
                                                            <!--<p title="Upvote" style="width: 40px;"><i class="fa-solid fa-circle-up fa-lg"></i><span><% //topicInfo.upvotes %>
                                    </span></p>-->
                                                            <span title="Share"><i
                                                                    class="fa-solid fa-arrow-up-from-bracket fa-lg"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Loop through each responses -->
                                            <div class="responses" style="width: 100%; padding: 0;">
                                                <%- include ("./topic_responses") %>
                                            </div>

                                            <div class="response-area">
                                                <span style="font-size: 16px;">Your response</span>
                                                <div class="tagged-msg">
                                                    <span class="icon"><i class="fa-solid fa-times"></i></span>
                                                    <div></div>
                                                </div>
                                                <div class="preview"></div>
                                                <div class="textarea">
                                                    <% if(isAMember==false){ %>
                                                        <textarea name="" id="response-text"
                                                            disabled>You cannot post a comment on this topic because your not a member of this forum!</textarea>
                                                        <% }else if(topicInfo.discussionClosed==true) { %>
                                                            <textarea name=""
                                                                id="response-text">You cannot post a comment on this topic because discussion has been closed!</textarea>
                                                            <% } else{ %>
                                                                <textarea name="" id="response-text"></textarea>
                                                                <% } %>
                                                </div>
                                                <div class="actions" <% if(isAMember==false ||
                                                    topicInfo.discussionClosed==true){%> style="display: none;" <% } %>>
                                                        <div class="icons">
                                                            <span onclick="createResponseImg()" title="Add Images"><i
                                                                    class="fa-regular fa-image"></i></span>
                                                            <span onclick="createResponseVideo()" title="Add Video"><i
                                                                    class="fa-solid fa-video"></i></span>
                                                            <!--<span title="Add File"><i class="fa-solid fa-paperclip"></i></span>-->
                                                        </div>
                                                        <button class="btn btn-primary" type="submit"
                                                            onclick="submitForumResponse('<%= topicInfo.forumID %>', '<%= topicInfo._id %>', '<%= JSON.stringify(forumInfo.wordsFilter) %>', '')"><i
                                                                class="fa-solid fa-paper-plane"></i><span>Send</span></button>
                                                </div>
                                            </div>
                                        </div>
                                </div>
                                <%- include ("./topic_category_middle") %>
                    </div>
                    <!--Middle ends here-->

                    <!--Right-->
                    <div class="right">
                        <!--Forums-->
                        <%- include ("./my_forums_right") %>
                            <!--Forums end here-->

                            <!-- ===============FORUM PROFILE=========================== -->
                            <% if(isAMember==true){ %>
                                <%- include ("./my_profile") %>
                                    <%}%>
                                        <!-- ===============FORUM PROFILE ENDS HERE=========================== -->

                                        <!--Forum box-->
                                        <%- include ("./topic_category_right") %>
                                            <!--Forum box end here-->
                    </div>
                    <div id="myImgModal" class="img-modal">
                        <button class="close-imgModal btn btn-primary"><i class="fa fa-angle-left"></i> Close</button>
                        <img id="modal-img" class="modal-content"
                            src="https://encrypted-tbn0.gstatic.com/images?q=tbn%3AANd9GcQS2ol73JZj6-IqypxPZXYS3rRiPwKteoD8vezk9QsRdkjt3jEn&usqp=CAU">
                    </div>
            </div>
        </main>

        <!--Ranking System-->
        <%- include ("./rank_modal") %>
            <!--Add Moderator Modal-->
            <%- include ("./moderator_modal") %>
            <%- include ("./member-modal") %>
                <!--Add Topic Modal-->
                <%- include ("./add_topic_modal") %>
                    <!--Theme Customization-->
                    <%- include ("../partials/themeCustomization") %>
                        <%- include ("../partials/popup") %>

                            <!--JS Script Attachment-->
                            <script src="/socket.io/socket.io.js"></script>
                            <%- include ("./forum_script") %>
                                <script>
                                    let myEditor;

                                    if (document.querySelector('#response-text')) {
                                        ClassicEditor
                                            .create(document.querySelector('#response-text'), {
                                                toolbar: {
                                                    // items: []
                                                    shouldNotGroupWhenFull: true
                                                },
                                            })
                                            .then(editor => {
                                                myEditor = editor;
                                            })
                                            .catch(error => {
                                                console.error(error);
                                            });
                                    }
                                </script>
                                <% if(isAMember==false || topicInfo.discussionClosed==true){ %>
                                    <script>
                                        myEditor.enableReadOnlyMode('response-text')
                                    </script>
                                    <% } %>
                                    <script src="../../../../js/script.js"></script>
                                    <script>
                                        const forumID = "<%= forumID %>";
                                        fetchAForumInfo(forumID, theUserID);
                                        getTopicCategories(forumID);

                                        // function fetchAForumInfo(forumID, userID) {
                                        //     socket.emit("fetchAForumInfo", { forumID, userID });
                                        //     primaryAlert.style.display = "block";
                                        //     primaryMessage.textContent = "Loading...";
                                        // }
                                        // function getTopicCategories(forumID) {
                                        //     socket.emit("getTopicCategories", { forumID })
                                        // }
                                    </script>
                                        <%- include ("./forum_script_two") %>
</body>

</html>