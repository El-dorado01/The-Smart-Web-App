        <script>
            var successAlert = document.getElementById("alert-success");
            var successAlertIcon = document.querySelector("#alert-success i");
            var successMessage = document.querySelector("#alert-success .msg")
            var dangerAlert = document.getElementById("alert-danger")
            var dangerMessage = document.querySelector("#alert-danger .msg")

            function btnX(userID, friendID, type, obj){
                var a = document.getElementById("btnX_" + friendID)
                var b = document.getElementById("btnX2_" + friendID)

                if(a.id == obj.id){
                    if(b.style.color = "var(--color-primary)"){
                        b.style.color = ""
                    }
                    a.style.color = "var(--color-primary)"
                    updateFriendRequest(userID, friendID, type)
                }else{
                    if (a.style.color = "var(--color-primary)") {
                        a.style.color = ""
                    }
                    b.style.color = "var(--color-primary)"
                    updateFriendRequest(userID, friendID, type)
                }
            }    
            function btnX2(userID, friendID, type, obj){
                var a = document.getElementById("btnX3_" + friendID)
                var b = document.getElementById("btnX4_" + friendID)

                if(a.id == obj.id){
                    if(b.style.color = "var(--color-primary)"){
                        b.style.color = ""
                    }
                    a.style.color = "var(--color-primary)"
                    updateFriendRequest(userID, friendID, type)
                }else{
                    if (a.style.color = "var(--color-primary)") {
                        a.style.color = ""
                    }
                    b.style.color = "var(--color-primary)"
                    updateFriendRequest(userID, friendID, type)
                }
            }    
            
            function deleteDeclinedRequest(userID, friendID){
                document.getElementById("contact_" + friendID).remove()
                socket.emit("deleteDeclinedRequest", { userID, friendID })
            }

            function blockUsers(userID, friendID, obj){
                if(obj.classList.contains("fa-user-slash")){
                    obj.classList.replace("fa-solid", "fa")
                    obj.classList.replace("fa-user-slash", "fa-user")
                    obj.style.color = ""
                    obj.title = "Block User"
                    if(document.getElementById("block_user")){
                        document.getElementById("block_user").style.display = "block"
                        document.getElementById("unblock_user").style.display = "none"
                    }
                    blockUserEmit(userID, friendID, "unblock")
                }else{
                    obj.classList.replace("fa", "fa-solid")
                    obj.classList.replace("fa-user", "fa-user-slash")
                    obj.style.color = "var(--color-primary)"
                    obj.title = "Unblock User"
                    if(document.getElementById("block_user")){
                        document.getElementById("block_user").style.display = "none"
                        document.getElementById("unblock_user").style.display = "block"
                    }
                    blockUserEmit(userID, friendID, "block")
                }
            }
