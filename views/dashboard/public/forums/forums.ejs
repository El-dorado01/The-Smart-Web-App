<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Header -->
    <%- include("../partials/header") %>
</head>

<body>
    <!-- NavBar -->
    <%- include ("../partials/navBar") %>

    <!--Main-->
    <main>
        <div class="container">
            <div class="alerts">
                <div class="alert-primary" id="alert-primary" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa-solid fa-spinner"></i>
                        <p class="msg"></p>
                    </div>
                </div>
                <div class="alert-success" id="alert-success" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa fa-check-circle"></i>
                        <p class="msg"></p>
                    </div>
                </div>
                <div class="alert-danger" id="alert-danger" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa fa-exclamation-circle"></i>
                        <p class="msg"></p>
                    </div>
                </div>
            </div>
            <!-- Sidebar -->
            <%- include ("../partials/sidebar") %>

            <!--Middle-->
            <div class="middle">
                <!--Forums-->
                <!-- <div class="user-chatroom">
                    <div class="chatroom">
                        <div class="chat-head">
                            <div style="width: 100%;" class="user-details">
                                <div>
                                    <h4>Welcome to the Chats</h4>
                                </div>
                            </div>
                        </div>
                        <div class="chat-body"
                            style="display: flex; flex-direction: column; align-items:center; justify-content:center; row-gap: 10px;">
                            <div style="display: flex; align-items: flex-start; column-gap: 5px;">
                                <i class="fa fa-star"></i> Your chats are displayed here.
                            </div>
                            <div style="display: flex; align-items: flex-start; column-gap: 5px;">
                                <i class="fa fa-star"></i> You can select a message in the chats menu at the right side
                            </div>
                            <div style="display: flex; align-items: flex-start; column-gap: 5px;">
                                <i class="fa fa-star"></i> All messages in a chat are encrypted
                            </div>
                        </div>
                    </div>
                </div> -->
                <%- include ("./middle_forum") %>
                <%- include ("./create_forum") %>
                <div class="messages" style="display: block;">
                    <div class="heading">
                        <h4>Suggested Forums</h4>
                        <i class="fa fa-users-rays"></i>
                    </div>
                    <% if (suggestedForums.length < 1) { %>
                        <div class="body" style="height: 45vh; font-size: 14px;">
                            <span class="text-muted">You have no forum suggestions at the moment</span>
                        </div>
                    <% }else{ %> 
                        <div class="scroll-bar" style="max-height: 70vh; margin-top: 10px;">
                            <% suggestedForums.forEach(forum => { %> 
                                <div class="forum">
                                    <a href="/dashboard/public/forum/<%= forum._id %>">
                                        <div class="info">
                                            <div class="profile-pic">
                                                <img src="<%= forum.displayPic %>" alt="">
                                            </div>
                                            <div class="message-body">
                                                <h5 style="font-size: 13px; font-weight: 600;"><%= forum.forumName %></h5>
                                                <p class="text-muted">
                                                    <%= forum.members.length %>
                                                        member<% if (forum.members.length> 1){%>s<%}%>
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                    <div class="action">
                                        <span class="remove-user" onclick="sendRequestToJoinTwo(this, '<%= forum._id %>', 'sendRequestToJoin')"
                                            style="background-color: var(--color-light); color: var(--color-dark); padding: 5px;"><i
                                                class="fa-solid fa-person-circle-plus"></i><strong>Join</strong></span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
                <!--Forum box end here-->
            </div>
            <!--Middle ends here-->

            <!--Right-->
            <%- include ("./right_forum") %>
        </div>
    </main>

    <!--Theme Customization-->
    <%- include ("../partials/themeCustomization") %>

    <!--JS Script Attachment-->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        var successAlert = document.getElementById("alert-success");
        var successAlertIcon = document.querySelector("#alert-success i");
        var successMessage = document.querySelector("#alert-success .msg")
        var primaryAlert = document.getElementById("alert-primary")
        var primaryMessage = document.querySelector("#alert-primary .msg")
        var dangerAlert = document.getElementById("alert-danger")
        var dangerMessage = document.querySelector("#alert-danger .msg")

    </script>
    <script src="../../../../js/script.js"></script>
</body>

</html>