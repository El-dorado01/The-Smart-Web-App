<% if(topicInfo.pinned==true){%>
    <div title="Unpin Discussion" id="pinDiscussion"
        onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'unpinDiscussion')"
        style="cursor: pointer;">
        <span style="color: var(--color-primary);"><i class="fa-solid fa-thumbtack fa-lg"></i></span>
    </div>
    <% }else{ %>
        <div title="Pin Discussion" id="pinDiscussion"
            onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'pinDiscussion')"
            style="cursor: pointer;">
            <span><i class="fa-solid fa-thumbtack fa-lg"></i></span>
        </div>
        <% } %>

            <% if(topicInfo.discussionClosed==true){%>
                <div title="Open Discussion"
                    onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'openDiscussion')"
                    id="openDiscussion" style="cursor: pointer;">
                    <span style="color: var(--color-primary);"><i class="fa-solid fa-comment-slash fa-lg"></i></span>
                </div>
                <% }else{ %>
                    <div title="Close Discussion"
                        onclick="performActionInForum('<%= forumID %>', '<%= topicInfo._id %>', 'closeDiscussion')"
                        id="closeDiscussion" style="cursor: pointer;">
                        <span><i class="fa-solid fa-comment-slash fa-lg"></i></span>
                    </div>
                    <% } %>

                        <script>
                            function performActionInForum(forumID, topicID, actionType) {
                                socket.emit("performActionInForum", { forumID, topicID, actionType });
                            }
                            socket.on("actionDone", data => {
                                if (data.success == true) {
                                    switch (data.actionType) {
                                        case "pinDiscussion":
                                            var pinBtn = document.getElementById("pinDiscussion")
                                            pinBtn.querySelector("span").style.color = "var(--color-primary)"
                                            pinBtn.title = "Unpin Discussion"
                                            pinBtn.setAttribute("onclick", "performActionInForum('" + data.forumID + "', '" + data.topicID + "', 'unpinDiscussion')")
                                            break;
                                        case "unpinDiscussion":
                                            var pinBtn = document.getElementById("pinDiscussion")
                                            pinBtn.querySelector("span").style.color = ""
                                            pinBtn.title = "Pin Discussion"
                                            pinBtn.setAttribute("onclick", "performActionInForum('" + data.forumID + "', '" + data.topicID + "', 'pinDiscussion')")
                                            break;
                                        case "closeDiscussion":
                                            var closeBtn = document.getElementById("closeDiscussion")
                                            closeBtn.querySelector("span").style.color = "var(--color-primary)"
                                            closeBtn.title = "Open Discussion"
                                            pinBtn.setAttribute("onclick", "performActionInForum('" + data.forumID + "', '" + data.topicID + "', 'openDiscussion')")
                                            break;
                                        default:
                                            var closeBtn = document.getElementById("closeDiscussion")
                                            closeBtn.querySelector("span").style.color = ""
                                            closeBtn.title = "Close Discussion"
                                            pinBtn.setAttribute("onclick", "performActionInForum('" + data.forumID + "', '" + data.topicID + "', 'closeDiscussion')")
                                            break;
                                    }
                                }
                            })

                        </script>