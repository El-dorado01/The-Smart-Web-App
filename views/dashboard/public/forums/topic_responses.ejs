                                                    <strong class="icon"><i
                                                            class="fa-solid fa-circle-up fa-lg"></i></strong><strong
                                                        class="count">
                                                        <%= response.response.upvotes %>
                                                    </strong>
                                                </span>
                                                <%} %>
                                                    <span title="Share"><i
                                                            class="fa-solid fa-arrow-up-from-bracket fa-lg"></i> </span>
                                                    <%  if(isAMember==true){  
                                                            if(response.response.userID==user._id){ %>
                                                                <span style="background-color: var(--color-danger);" title="Delete" onclick="deleteResponseInForum('<%= response.response._id %>','<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response.userID %>','responseDelete','<%= response.response._id %>')">
                                                                    <i class="fa-solid fa-trash fa-lg"></i>
                                                                </span>
                                                        <%  }else if(response.response.userID==forumInfo.creator){ %>
                                                        <%  }else if(forumInfo.creator==user._id){ 
                                                                for (let i=0; i < forumInfo.members.length; i++) {
                                                                    if(forumInfo.members[i].userID==response.response.userID){
                                                                        if(forumInfo.members[i].memberStatus=="inactive" || forumInfo.members[i].memberStatus=="ejected") {%>
                                                                            <span style="background-color: var(--color-danger);" title="Delete" onclick="deleteResponseInForum('<%= response.response._id %>','<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response.userID %>','responseDelete','<%= response.response._id %>')">
                                                                                <i class="fa-solid fa-trash fa-lg"></i>
                                                                            </span>
                                                                    <%  } else { %>
                                                                            <div style="position: relative;"
                                                                                id="other-actions-<%= response.response._id %>">
                                                                                <span title="More"
                                                                                    onclick="showOtherActionsInForum('<%= response.response._id %>', '<%= topicInfo.forumID %>', '<%= response.response.userID %>', '<%= topicInfo._id %>', 'responseDelete', '<%= response.response._id %>')"><i
                                                                                        class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                                            </div>
                                                                    <%  
                                                                        } 
                                                                    } 
                                                                } 
                                                            } else { 
                                                                for (let i=0; i < forumInfo.moderators.length; i++) {
                                                                    if(forumInfo.moderators[i].userID==user._id) { 
                                                                        for (let i=0; i < forumInfo.members.length; i++) {
                                                                            if(forumInfo.members[i].userID==response.response.userID){
                                                                                if(forumInfo.members[i].memberStatus=="inactive" || forumInfo.members[i].memberStatus=="ejected") {%>
