        <script>
            // Get the modal
            var modal = document.getElementById("myImgModal");

            var modalImg = document.getElementById("modal-img");
            var captionText = document.getElementById("caption");

            document.addEventListener("click", (e) => {
                const elem = e.target;
                var postText = document.querySelector(".postText_" + elem.classList)
                if (elem.id === "postImg") {
                    modal.style.display = "block";
                    modalImg.src = elem.dataset.biggerSrc || elem.src;
                    captionText.innerHTML = postText.innerHTML;
                }
            })

            // Get the <span> element that closes the modal
            var span = document.getElementsByClassName("close-imgModal")[0];

            // When the user clicks on <span> (x), close the modal
            span.onclick = function () {
                modal.style.display = "none";
            }

            function showReqoute(id) {
                var requoteBody = document.getElementById("requote-body-" + id)

                if (!requoteBody.querySelector("#requote-" + id)) {
                    var div = document.createElement("div")
                    div.innerHTML = `
                    <div class="requote" id="requote-${id}">
                        <div class="one">
                            <i class="fa-solid fa-retweet"></i>
                            <span>Quote</span>
                        </div>
                        <div class="two" onclick="qouteWithComment('${id}')">
                            <i class="fa fa-reply"></i>
                            <span>Qoute with comment</span>
                        </div>
                    </div>
                    <div class="requote-modal" id="requote-modal-${id}" onclick="closeRequote(this, '${id}')"></div>
                `

                    requoteBody.appendChild(div)
                } else {
                    var requote = document.getElementById("requote-" + id)
                    var requoteModal = document.getElementById("requote-modal-" + id)

                    requote.style.display = "block"
                    requoteModal.style.display = "block"
                }
            }

            function closeRequote(obj, id) {
                // var requoteBody = document.querySelector("#requote-body-" + id)
                var requote = document.getElementById("requote-" + id)
                obj.style.display = "none"
                requote.style.display = "none"
            }

            function qouteWithComment(id) {
                //Get the add Post Panel
                const addPostModal = document.querySelector(".add-post-modal");

                //Display the add post panel
                addPostModal.style.display = "grid";

                var requote = document.getElementById("requote-" + id)
                var requoteModal = document.getElementById("requote-modal-" + id)
                requoteModal.style.display = "none"
                requote.style.display = "none"
            }
        </script>
