<!--Add Post Modal-->
<div class="add-post-modal">
    <div class="card">
        <div class="close-addPost" style="cursor: pointer;">
            <span class="fa fa-times"></span>
        </div>
        <h2>Add a Post</h2>
        <!-- <p class="text-muted">Manage your font-size, color and background</p> -->
        <div class="post-form">
            <div class="attach-quote">
                <div class="media">
                    <div class="images-grid">
                        <div>
                            <img src="../../../../images/f4.jpg" alt="">
                        </div>
                        <div>
                            <img src="../../../../images/f2.jpg" alt="">
                        </div>
                        <div>
                            <img src="../../../../images/f4.jpg" alt="">
                        </div>
                        <div>
                            <img src="../../../../images/f2.jpg" alt="">
                        </div>
                        <!-- <div class="attach-third-media">
                            <img src="../../../../images/f2.jpg" alt="">
                        </div> -->
                    </div>
                </div>
                <div class="media-caption">
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Veniam, consectetur?
                </div>
            </div>
            <div class="theFields">
                <div class="field" id="field_1234">
                    <div class="one">
                        <img src="../../../uploads/<%= user.avatar %>" alt="">
                        <textarea class="fieldText" id="post-msg-1234" oninput="countChars('1234')"
                            placeholder="What's on your mind?"></textarea>
                    </div>
                    <div class="preview">
                        <!-- <div class="sub-video">
                            <span><i class="fa fa-times"></i></span>
                            <video src="../../../videos/video1.mp4" autoplay controls></video>
                        </div> -->
                    </div>
                    <div class="not-active" onclick="makeActive(this,'1234')"></div>
                </div>
            </div>


            <div class="actions">
                <div class="icons">
                    <span onclick="createVideo('1234')" title="Select Video" class="selectVideo"
                        style="cursor: pointer;"><i class="fa fa-video"></i></span>
                    <span onclick="createImg('1234')" title="Select Images" class="selectImg"
                        style="cursor: pointer;"><i class="fa fa-camera"></i></span>
                    <button class="btn" id="add-thread" onclick="addThread('1234')" disabled title="Add Thread"
                        style="background-color: var(--color-light); color: var(--color-gray); display: none;">
                        <i class="fa fa-plus"></i> <span class="add-thread">Add Thread</span>
                    </button>
                    <!-- <span> <i class="fas fa-save"></i> </span>
                    <span> <i class="fa fa-clipboard-list"></i> </span> -->
                </div>
                <span class="text-muted"><span id="charText">300</span> chars</span>
            </div>

            <div class="tags">
                <div class="select-box">
                    <div class="options-container2">
                        <div class="option" onclick="updateVideoOption(this)">
                            <input type="radio" name="spaceFor" value="Everyone" class="radio">
                            <label for="everyone">Everyone</label>
                        </div>
                        <div class="option" onclick="updateVideoOption(this)">
                            <input type="radio" name="spaceFor" value="Followers" class="radio">
                            <label for="Followers">Followers</label>
                        </div>
                        <div class="option" onclick="updateVideoOption(this)">
                            <input type="radio" name="spaceFor" value="People you mention" class="radio">
                            <label for="People you mention">People you mention</label>
                        </div>
                    </div>
                    <div class="selected" style="background-color: var(--color-gray);" onclick="toggleVideoSpace()">
                        Who can comment?
                        <span class="fa fa-angle-down angle1"></span>
                        <span class="fa fa-angle-up angle2"></span>
                    </div>
                    <label class="option-label">Who can comment?</label>
                </div>
                <div class="select-box2" id="myVideoForums">
                    <label class="option-label">Who can see your post?</label>
                    <div class="selected2" style="background-color: var(--color-gray);" onclick="toggleVideoSpace2()">
                        Who can see your post?
                        <span class="fa fa-angle-down angle3"></span>
                        <span class="fa fa-angle-up angle4"></span>
                    </div>
                    <div class="options-container-video-forum">
                        <div class="option" onclick="updateVideoOption2(this)">
                            <input type="radio" name="forum" value="Everyone" class="radio">
                            <label for="Everyone">Everyone</label>
                        </div>
                        <div class="option" onclick="updateVideoOption2(this)">
                            <input type="radio" name="forum" value="Followers" class="radio">
                            <label for="Followers">Followers</label>
                        </div>
                        <div class="option" onclick="updateVideoOption2(this)">
                            <input type="radio" name="forum" value="People you mention" class="radio">
                            <label for="People you mention">People you mention</label>
                        </div>
                    </div>
                </div>

                <!-- <div class="child">
                    <label for="commentators">Who can comment?</label>
                    <select id="commentators">
                        <option value="">Everyone</option>
                        <option value="">Followers</option>
                        <option value="">People you mention</option>
                    </select>
                </div>
                <div class="child">
                    <label for="viewers">Who can see your post?</label>
                    <select id="viewers">
                        <option value="">Everyone</option>
                        <option value="">Followers</option>
                        <option value="">People you mention</option>
                    </select>
                </div> -->
            </div>

            <div class="buttons">
                <div>
                    <button class="btn" disabled id="post-btn-save" title="Save Post" onclick="savePost()">
                        Save <i class="fas fa-save"></i>
                    </button>
                    <button class="btn" id="draft-btn" onclick="showDrafts('<%= user._id %>')" title="Drafts"
                        style="background-color: var(--color-gray); color: black;">
                        Drafts <i class="fa fa-clipboard-list"></i>
                    </button>
                </div>
                <button id="post-btn" onclick="submitPost()" disabled class="btn">Post</button>
            </div>
        </div>
    </div>
</div>
