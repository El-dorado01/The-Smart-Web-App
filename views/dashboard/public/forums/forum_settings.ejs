<div class="settings">
    <h3>Settings &nbsp; <i class="fa-solid fa-cog"></i></h3>
    <div class="action">
        <h4>Change Forum Display Picture</h4> <label for="logo"><span><i class="fa-solid fa-pencil"></i></span></label>
        <input type="text" style="display: none;" id="forumIDForUpload" value="<%= forumID %>">
        <input type="file" name="" id="logo" style="display: none;" accept="image/*" onchange="showPreview4(event);">
    </div>
    <div class="image-preview" id="showForumDP">
        <div class="pic">
            <img id="img-preview3" alt="">
        </div>
        <button class="btn btn-primary" onclick="updateForumDisplayPic()">Apply</button>
    </div>
    <div class="action">
        <h4>Modify Moderators</h4> <span onclick="toggleSettingsChild('moderators')"><i
                class="fa-solid fa-pencil"></i></span>
    </div>
    <div class="settings-child moderators">
        <div class="child"></div>
        <button class="btn btn-gray" onclick="document.querySelector('.member-modal').style.display = 'grid';"
            style="display: flex; gap: 7px; align-items: center; justify-content: center;" id="add-moderator"><i
                class="fa-solid fa-plus"></i><span>Add a
                Moderator</span></button>
    </div>
    <div class="action">
        <h4>Update Forum Information</h4> <span onclick="toggleSettingsChild('update-forum-info')"><i
                class="fa-solid fa-pencil"></i></span>
    </div>
    <div class="settings-child update-forum-info">
        <div class="info">
            <h4>Available for Look-up</h4>
            <input type="checkbox" name="" id="availableForLookUp">
        </div>
        <div class="input-field">
            <label for="forumName">Forum Name</label>
            <input type="text" name="forumName" id="forumNameInput" required placeholder="Forum Name">
        </div>
        <div class="input-field-textarea">
            <label>Forum Description</label>
            <textarea name="" id="forumDescInput" required placeholder="Forum Description"></textarea>
        </div>
        <label for="filter-value">Filter Unwanted words (You can add many words separated with comma
            and
            press enter key)</label>
        <div class="word-tags">
            <div class="up"></div>
            <div class="down">
                <textarea name="" id="filter-value"></textarea>
            </div>
        </div>
        <button class="btn btn-gray" style="display: flex; gap: 7px; align-items: center; justify-content: center;"
            onclick="updateForumProfile('<%= forumID %>')"><i class="fa-solid fa-pen"></i><span>Update
                Info</span></button>
    </div>
    <div class="action">
        <h4>Update Forum Ranking System</h4> <span
            onclick="document.querySelector('.rank-modal').style.display = 'grid';" id="update-forum-rank"><i
                class="fa-solid fa-pencil"></i></span>
    </div>
    <div class="action">
        <h4>Copy Forum Invite Link</h4> <span title="Copy Invite Link"
            onclick="copyForumInviteLink('<%= forumInfo.forumSecretKey %>', '<%= forumID %>', '<%= getURL %>/dashboard/public/forum_invites/<%= forumID %>/key?secretKey=')"><i
                class="fa-solid fa-link"></i></span>
    </div>
    <!-- <div class="action">
        <h4>Send an Invite to a Friend</h4> <span><i class="fa-solid fa-paper-plane"></i></span>
    </div> -->
</div>