<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Header -->
    <%- include("../partials/header") %>
</head>

<body>
    <!-- NavBar -->
    <%- include ("../partials/navBar") %>

    <!--Main-->
    <main>
        <div class="container">
            <div class="alerts">
                <div class="alert-primary" id="alert-primary" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa-solid fa-spinner"></i>
                        <p class="msg"></p>
                    </div>
                </div>
                <div class="alert-success" id="alert-success" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa fa-check-circle"></i>
                        <p class="msg"></p>
                    </div>
                </div>
                <div class="alert-danger" id="alert-danger" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa fa-exclamation-circle"></i>
                        <p class="msg"></p>
                    </div>
                </div>
            </div>
            <!-- Sidebar -->
            <%- include ("../partials/sidebar") %>

            <!--Middle-->
            <div class="middle">
                <!--Forums-->
                <%- include ("./my_forums_middle") %>
                <!-- <div class="user-chatroom">
                    <div class="chatroom">
                        <div class="chat-head">
                            <div style="width: 100%;" class="user-details">
                                <div>
                                    <h4>Welcome to the Chats</h4>
                                </div>
                            </div>
                        </div>
                        <div class="chat-body"
                            style="display: flex; flex-direction: column; align-items:center; justify-content:center; row-gap: 10px;">
                            <div style="display: flex; align-items: flex-start; column-gap: 5px;">
                                <i class="fa fa-star"></i> Your chats are displayed here.
                            </div>
                            <div style="display: flex; align-items: flex-start; column-gap: 5px;">
                                <i class="fa fa-star"></i> You can select a message in the chats menu at the right side
                            </div>
                            <div style="display: flex; align-items: flex-start; column-gap: 5px;">
                                <i class="fa fa-star"></i> All messages in a chat are encrypted
                            </div>
                        </div>
                    </div>
                </div> -->
                <%- include ("./create_forum") %>
                <!--Forum box end here-->
            </div>
            <!--Middle ends here-->

            <!--Right-->
            <div class="right">
                <div class="messages">
                    <div class="heading">
                        <h4>Forums</h4>
                        <i class="fa fa-users-rays"></i>
                    </div>
                    <div class="category">
                        <h6 class="active tablinks2" class="archive" onclick="openTab2(event, 'my-forums')" id="defaultOpen2">My Forums
                            &nbsp; <i class="fa-solid fa-users-rays" style="font-size: 1rem;"></i> <span class="msg-archive">
                                <%= forums.length %>
                            </span>
                        </h6>
                        <h6 class="tablinks2" onclick="openTab2(event, 'forum-invites')" style="font-size: 1rem;">
                            Invites &nbsp; <i class="fa-solid fa-envelope-open-text"></i>
                            <span class="msg-archive">4</span>
                        </h6>
                    </div>
                    <div class="postFeeds2" id="my-forums">
                        <% if (forums.length < 1) { %>
                            <div class="body">
                                <span class="text-muted">You have no forums</span>
                            </div>
                        <% }else{ %>
                            <!--Search Bar-->
                            <div class="search-bar">
                                <i class="fa fa-search"></i>
                                <input type="search" placeholder="Search" id="message-searchs">
                            </div>
                            <div class="scroll-bar">
                                <% forums.forEach(forum=> { %>
                                    <div class="message">
                                        <a href="/dashboard/public/forum/<%= forum._id %>">
                                            <div class="profile-pic">
                                                <img src="<%= forum.displayPic %>" alt="">
                                            </div>
                                        </a>
                                        <div class="message-body">
                                            <a href="/dashboard/public/forum/<%= forum._id %>">
                                                <h5 style="font-size: 13px; font-weight: 600;">
                                                    <%= forum.forumName %>
                                                </h5>
                                            </a>
                                            <p class="text-muted">
                                                <%= forum.members.length %>
                                                    member<% if (forum.members.length> 1){%>s<%}%>
                                            </p>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                        <button class="btn btn-primary" style="margin-top: 10px;" onclick="showCreateForum()">
                            <span class="fa fa-plus"></span>
                            Create a Forum
                        </button>
                    </div>
                    <div class="postFeeds2" id="forum-invites">
                        <% if (invites.length < 1) { %>
                            <div class="body">
                                <span class="text-muted">You have no invites</span>
                            </div>
                        <% } else { %>
                            <div class="scroll-bar">
                                <div class="messages">
                                    <% invites.forEach(invite=> { %>
                                        <div class="forum">
                                            <div class="info">
                                                <div class="profile-pic">
                                                    <img src="<%= invite.displayPic %>" alt="">
                                                </div>
                                                <div class="message-body">
                                                    <h5 style="font-size: 13px; font-weight: 600;">
                                                        <%= invite.forumName %>
                                                    </h5>
                                                    <p class="text-muted">
                                                        <%= invite.members.length %>
                                                            member<% if(invite.members.length> 1){%>s<%}%>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="action">
                                                <span onclick="updateInvite('<%= invite._id %>', '<%= userID %>', 'accept')"><i
                                                        class="fa-solid fa-check"></i></span>
                                                <span onclick="updateInvite('<%= invite._id %>', '<%= userID %>', 'reject')"><i
                                                        class="fa-solid fa-times"></i></span>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
                <!--Forums-->
                <%- //include ("./my_forums_right") %>
                <!--Forums end here-->
            </div>
        </div>
    </main>

    <!--Theme Customization-->
    <%- include ("../partials/themeCustomization") %>

    <!--JS Script Attachment-->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        var successAlert = document.getElementById("alert-success");
        var successAlertIcon = document.querySelector("#alert-success i");
        var successMessage = document.querySelector("#alert-success .msg")
        var primaryAlert = document.getElementById("alert-primary")
        var primaryMessage = document.querySelector("#alert-primary .msg")
        var dangerAlert = document.getElementById("alert-danger")
        var dangerMessage = document.querySelector("#alert-danger .msg")
    </script>
    <script src="../../../../js/script.js"></script>
</body>

</html>