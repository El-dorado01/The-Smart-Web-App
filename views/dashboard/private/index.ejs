    <script>
        function openChatRoom(chatroomID){
            socket.emit("userChatroom", chatroomID)
        }

        function displayChatRoom(response) {
            const chatroom = document.querySelector(".chatroom")
            const myID = '<%= user._id %>'
            chatroom.innerHTML = `
                <div class="chat-head">
                    <a class="close-chat">
                        <span class="fa fa-arrow-left chat-icon"></span>
                    </a>
                    <div href="" class="user-details" onclick="showProfile()">
                        <img src="../../../uploads/${
                            response.recipientDetails._id === myID 
                            ? response.senderDetails.avatar
                            : response.recipientDetails.avatar
                        }" class="profile-pic" alt="">
                        <div>
                            <h4>${
                                    response.recipientDetails._id === myID
                                    ? response.senderDetails.username
                                    : response.recipientDetails.username
                                }
                            </h4>
                            <div align="center" class="online-status">
                                <span>Online</span> 
                                <div class="status"></div>
                            </div>
                        </div>
                    </div>
                    <a href="">
                        <span class="fa fa-video-camera chat-icon"></span>
                    </a>
                    <a href="">
                        <span class="fa fa-phone chat-icon"></span>
                    </a>
                    <a href="">
                        <span class="fa fa-ellipsis-v chat-icon"></span>
                    </a>
                </div>
                <div class="chat-body">
                    ${
                        response.roomMessages.map ((roomMessage) => {
                            return `
                                    ${roomMessage.message.sender === myID 
                                    ? `
                                        <div class="chat">
                                            <div class="sp id${response.senderDetails._id}"></div>
                                            <div class="sender">
                                                <div class="sender-box"></div>
                                                <p class="chat-msg">
                                                    ${roomMessage.message.message}
                                                </p>
                                                <p align="right" class="chat-time">
                                                    <span>${roomMessage.time}</span>
                                                    <span class="fa fa-check-double msg-status"></span>
                                                </p>
                                            </div>
                                        </div>
                                    `
                                    : `
                                        <div class="chat">
                                            <div class="recipient">
                                                <div class="recipient-box"></div>
                                                <p class="chat-msg">
                                                    ${roomMessage.message.message}
                                                </p>
                                                <p align="right" class="chat-time">
                                                    <span>${roomMessage.time}</span>
                                                    <span class="fa fa-check-double msg-status"></span>
                                                </p>
                                            </div>
                                            <div class="sp id${response.recipientDetails._id}"></div>
                                        </div>
                                    `}
                                `
                        }).join("")
                    }
                </div>
                <div class="chat-widgets">
                    <div class="msg-textarea">
                        <button>
                            <span class="fa fa-smile widgets-icon"></span>
                        </button>
                        <textarea name="message" id="myMessage${response.findRoom._id}" placeholder="Type a message..."></textarea data-emojiable="true">
                        <button>
                            <span class="fa-solid fa-paperclip widgets-icon"></span>
                            <!-- <span class="fa fa-image widgets-icon"></span> -->
                        </button>
                        <button onclick="submitMessage('${response.findRoom._id}')">
                            <i class="fas fa-paper-plane widgets-icon"></i>
                        </button>
                    </div>
                    <button class="mic">
                        <span class="fa fa-microphone widgets-mic"></span>
                    </button>
                </div>
            `
        }

        function submitMessage(chatroomID) {
            const myMessage = document.getElementById("myMessage"+chatroomID).value
            const senderID = "<%= user.id %>"
            document.getElementById("myMessage"+chatroomID).value = ""

            // socket.emit("chatMessage", { myMessage, senderID, chatroomID })
            socket.emit("chatMessage", { myMessage, senderID, chatroomID })
        }

        function displayMessage(response){
            const allChats = document.querySelectorAll(".chat")
            const lastChat = allChats[allChats.length - 1]
            var chatClass = lastChat.querySelector(".sp").classList

            const chatBody = document.querySelector(".chat-body");

            // console.log(response.user);
            const div = document.createElement("div");
            div.classList.add("chat");

            if (response.myMessage.sender === '<%= user._id %>') {
                div.innerHTML = `
                    <div class="sp"></div>
                    <div class="sender">
                        ${
                            chatClass.contains("id<%= user._id %>")
                            ? ""
                            : `<div class="sender-box"></div>`
                        }
                        <p class="chat-msg">
                            ${response.myMessage.message}
                        </p>
                        <p align="right" class="chat-time">
                            <span>${response.time}</span>
                            <span class="fa fa-check-double msg-status"></span>
                        </p>
                    </div>
                `;
            } else {
                div.innerHTML = `
                    <div class="recipient">
                        ${
                            chatClass.contains("id<%= user._id %>")
                            ? `<div class="recipient-box"></div>`
                            : ""
                        }
                        <p class="chat-msg">
                            ${response.myMessage.message}
                        </p>
                        <p align="right" class="chat-time">
                            <span>${response.time}</span>
                            <span class="fa fa-check-double msg-status"></span>
                        </p>
                    </div>
                    <div class="sp"></div>
                `;
            }

            chatBody.appendChild(div);
        }
    </script>
    <!--JS Script Attachment-->
    <script src="/socket.io/socket.io.js"></script>
    <script src="../../../js/script.js"></script>
