<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Header -->
    <%- include("./partials/header") %> 
</head>
<body>
    <!-- NavBar -->
    <%- include ("./partials/navBar") %> 

    <!--Main-->
    <main>
        <div class="container">
            
            <div class="alerts">
                <div class="alert-success" id="alert-success" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa fa-check-circle"></i>
                        <p class="msg"></p>
                    </div>
                </div>
                <div class="alert-danger" id="alert-danger" style="display: none;">
                    <span class="fa fa-times"></span>
                    <div class="body">
                        <i class="fa fa-exclamation-circle"></i>
                        <p class="msg"></p>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <%- include ("./partials/sidebar") %> 

            <!--Middle-->
            <div class="middle">
                <div class="feeds">
                    <div class="feed feedpost<%= singleFeed._id %>">
                        <div class="head">
                            <div class="user">
                                <div class="profile-pic">
                                    <img src="../../../images/smart.png" alt="">
                                </div>
                                <div class="info">
                                    <h3>The Smart Network <span class="fa fa-certificate"></span></h3>
                                    <small><%= singleFeed.category %>, 
                                        <% var timeInMS=new Date() - new Date(singleFeed.createdAt); var secs=timeInMS / 1000; var mins=timeInMS / (1000 * 60); var
                                            hours=timeInMS / (1000 * 60 * 60); var days=timeInMS / (1000 * 60 * 60 * 24); var weeks=timeInMS / (1000 * 60 * 60 *
                                            24 * 7); 
                                            if( days> 13.999){ %>
                                            <%= Math.round(weeks) %> weeks
                                            <% }else if( days> 6.999){ %>
                                            <%= Math.round(weeks) %> week
                                                <% }else if( hours> 35.99){ %>
                                                    <%= Math.round(days) %> days
                                                <% }else if( hours> 23.99){ %>
                                                    <%= Math.round(days) %> day
                                                        <% }else if(mins> 119) { %>
                                                            <%= Math.round(hours) %> hrs
                                                        <% }else if(mins> 59) { %>
                                                            <%= Math.round(hours) %> hr
                                                                <% }else if(secs> 119){ %>
                                                                    <%= Math.round(mins) %> mins
                                                                <% }else if(secs> 59){ %>
                                                                    <%= Math.round(mins) %> min
                                                                        <% }else{ %>
                                                                            <%= Math.round(secs) %> secs
                                                                                <% } %>
                                        ago</small>
                                </div>
                            </div>
                            <span class="fa fa-ellipsis" style="cursor: pointer;" onclick="showActionBox3()"></span>
                        </div>
                        <div class="action-box box<%= singleFeed._id %>">
                            <div>
                                <i class="fa fa-share"></i>
                                <span>Share Post</span>
                            </div>
                            <div onclick="copyPlaylistLink('<%= getURL %>/dashboard/private/smart_network/<%= singleFeed._id %>'),closeActionBox('<%= singleFeed._id %>')">
                                <i class="fa fa-clipboard"></i>
                                <span>Copy Link</span>
                            </div>
                            <div class="report">
                                <i class="fa fa-flag"></i>
                                <span>Report Post</span>
                            </div>
                        </div>
                        <div class="feed-body">
                            <% if(singleFeed.fileUploads. indexOf('https://res.cloudinary.com/eldoradotechguy/video/')> -1){ %>
                                <video class="videoInsert" controls autoplay>
                                    <source src="<%= singleFeed.fileUploads %>" type="video/mp4">
                                </video>
                            <% }else{ %>
                                <img src="<%= singleFeed.fileUploads %>" alt="File Uploaded">
                            <% } %>
                        </div>
                        <div class="feed-text">
                            <%= singleFeed.notes %>
                        </div>
                        <div class="action-button">
                            <% var likesArray=[]; singleFeed.likes.forEach((feed)=> {
                                likesArray.push(feed.user);
                                });
                                %>
                            <div class="interaction-button">
                                <span style="cursor: pointer;">
                                    <i class="fa 
                                    <% if(likesArray.includes(user._id.toString())){ %> 
                                        fa-heart
                                    <% }else{ %> 
                                        fa-heart-o
                                    <% } %>" style="color: var(--color-primary);"
                                    onclick="likePost(this, '<%= user._id %>', '<%= singleFeed._id %>')"></i>
                                </span>
                                <span>
                                    <label for="myReply">
                                        <i class="fa-regular fa-comment-dots" style="color: var(--color-primary);"></i>
                                    </label>
                                </span>
                                <span><i class="fa fa-share-alt" style="color: var(--color-primary);"></i></span>
                            </div>
                            <div class="bookmark" style="cursor: pointer;">
                                <span><i class="fa 
                                    <% if(bookmarks){
                                        if(bookmarks.includes(singleFeed._id.toString())){ %> 
                                        fa-bookmark
                                    <% }else{ %> 
                                        fa-bookmark-o
                                    <% } } else {%>
                                        fa-bookmark-o
                                        <% } %>"
                                    style="color: var(--color-primary);"
                                    onclick="bookmark(this, '<%= user._id %>', '<%= singleFeed._id %>')"></i>
                                </span>
                            </div>
                        </div>
                        <div class="liked-by">
                            <!--<span><img src="../../../images/smart.png" alt=""></span>
                                <span><img src="../../../images/smart.png" alt=""></span>
                                <span><img src="../../../images/smart.png" alt=""></span>
                                <p>Liked by <b>Karimu Abija</b> and <b>20 others</b></p>-->
                            <% if(likesArray.length> 0){ %>
                                <p><i class="fa fa-dot-circle-o"></i></p>
                                <p>
                                    <%= likesArray.length %> like<% if(likesArray.length> 1){%>s<%}%>
                                </p>
                                <% } %>
                        </div>
                        <% if(singleFeed.comments.length > 10){ %>
                        <div class="text-muted show-more">Show more comments</div>
                        <% } %>
                        <div class="caption">
                            <% singleFeed.comments.forEach(comment => { %>
                            <div class="comment-section comment<%= comment._id %>">
                                <div class="single-comment">
                                    <span class="user-avatar">
                                        <img src="../../../uploads/<%= comment.avatar %>" alt="">
                                    </span>
                                    <span class="user">
                                        <p>
                                            <b style="margin-right: 5px;">
                                            <%= comment.username %>
                                            </b>
                                        </p>
                                        <span><%= comment.message %></span>                                  
                                    </span>
                                </div>
                                <span class="actions">
                                    <span>
                                        <% var commentTimeInMS=new Date() - new Date(comment.datePosted); var commentSecs=commentTimeInMS / 1000; var commentMins=commentTimeInMS / (1000 * 60);
                                            var commentHours=commentTimeInMS / (1000 * 60 * 60); var commentDays=commentTimeInMS / (1000 * 60 * 60 * 24); var commentWeeks=commentTimeInMS / (1000 * 60 *
                                            60 * 24 * 7); 
                                            if( commentDays> 13.999){ %>
                                            <%= Math.round(commentWeeks) %> weeks
                                            <% }else if( commentDays> 6.999){ %>
                                            <%= Math.round(commentWeeks) %> week
                                                <% }else if( commentHours> 35.99){ %>
                                                    <%= Math.round(commentDays) %> days
                                                <% }else if( commentHours> 23.99){ %>
                                                    <%= Math.round(commentDays) %> day
                                                        <% }else if(commentMins> 119) { %>
                                                            <%= Math.round(commentHours) %> hrs
                                                        <% }else if(commentMins> 59) { %>
                                                            <%= Math.round(commentHours) %> hr
                                                                <% }else if(commentSecs> 119){ %>
                                                                    <%= Math.round(commentMins) %> mins
                                                                <% }else if(commentSecs> 59){ %>
                                                                    <%= Math.round(commentMins) %> min
                                                                        <% }else{ %>
                                                                            <%= Math.round(commentSecs) %> secs
                                                                                <% } %>
                                    </span>
                                    <!--<span> Like <i class="fa fa-thumbs-up"></i></span>-->
                                    <span onclick="tagComment('<%= comment._id %>','<%= comment.username %>','<%= comment.message %>', '<%= comment.uniqID %>')"> Reply <i
                                            class="fa fa-reply"></i></span>
                                </span>
                                <%  
                                comment.moreComments.slice(-2).forEach(moreComment=> {
                                %>
                                    <div class="under-comments">
                                        <span class="user-avatar">
                                            <img src="../../../uploads/<%= moreComment.moreUserAvatar %>" alt="">
                                        </span>
                                        <span class="user">
                                            <p>
                                                <b style="margin-right: 5px;">
                                                    <%= moreComment.moreUsername %>
                                                </b>
                                            </p>
                                            <span>
                                            <%= moreComment.moreUserMessage %>
                                            </span>
                                        </span>
                                    </div>
                                <% }) %>
                                <% if(comment.moreComments.length> 2){ %>
                                    <div style="margin-bottom: 10px; text-align: center; cursor: pointer;" onclick="showReplies('<%= user._id %>', '<%= comment.uniqID %>', '<%= comment._id %>', '<%= singleFeed._id %>')">View all <%= comment.moreComments.length %> replies</div>
                                <% } %>
                            </div>
                            <% }) %>
                        </div>
                        <form id="<%= singleFeed._id  %>" class="comment-form">
                            <div class="tag-comment" style="opacity: 0;">
                                <span><i class="fa fa-reply"></i></span>
                                <div class="right-comment">
                                    <div class="comment-owner"></div>
                                    <div class="owner-comment"></div>
                                </div>
                                <span onclick="closeTagComment()" style="cursor: pointer;"><i class="fa fa-times"></i></span>
                            </div>
                            <div class="text-muted submit-comment">
                                <input type="hidden" class="postID" name="postID" value="<%= singleFeed._id %>">
                                <input type="hidden" class="uniqID" name="uniqID" value="">
                                <input type="hidden" class="commentID" name="commentID" value="">
                                <i class="fa fa-smile"></i>
                                <input type="text" required id="myReply" class="myReply" name="myReply" placeholder="Type your comments...">
                                <button type="submit" style="background: transparent; color: gray; cursor: pointer;">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="reply-container"></div>
                </div>                
            </div>
            <!--Middle ends here-->

            <!--Right-->
            <div class="right">
                <div class="messages">
                    <div class="heading">
                        <h4>Actions</h4>
                        <i class="fa fa-cog"></i>
                    </div>
                    <button class="btn btn-primary" style="margin-top: 10px;" onclick="actionRedirect('<%= bookmarks %>', 'bookmarks')">
                        <span class="fa fa-bookmark"></span>
                        Bookmarks
                    </button>
                    <button class="btn btn-primary" style="margin-top: 10px;" onclick="actionRedirect('<%= likesArray.length %>', 'likes')">
                        <span class="fa fa-heart"></span>
                        Likes
                    </button>
                </div>
                <!--Friend Requests start here-->
                <% if(friends !="empty" ){ %>
                    <div class="friend-requests">
                        <h4>Requests</h4>
                        <% friends.forEach(request=> {
                            if(request.sender != user._id.toString()){
                            %>
                            <div class="request" id="<%= request.details._id %>">
                                <div class="info">
                                    <a href="/dashboard/private/profile/<%= request.details._id %>">
                                        <div class="profile-pic">
                                            <img src="../../../uploads/<%= request.details.avatar %>" alt="">
                                        </div>
                                    </a>
                                    <div class="about">
                                        <a href="/dashboard/private/profile/<%= request.details._id %>">
                                            <h5>
                                                <%= request.details.username %>
                                            </h5>
                                            <p class="text-muted">
                                                <% if(request.details.about.length> 45){ %>
                                                    <%= request.details.about.slice(0,45) %>...
                                                        <% }else{ %>
                                                            <%= request.details.about %>
                                                                <% } %>
                                            </p>
                                        </a>
                                    </div>
                                </div>
                                <div class="action">
                                    <button class="btn btn-primary"
                                        onclick="updateFriendRequest('<%= user._id %>','<%= request.details._id %>', 'accept')">
                                        Accept
                                    </button>
                                    <button class="btn"
                                        onclick="updateFriendRequest('<%= user._id %>','<%= request.details._id %>', 'decline')">
                                        Decline
                                    </button>
                                </div>
                            </div>
                            <% } }) %>
                    </div>
                <!--Friend Request end here-->
                <% } %>
            </div>

            <div class="channel-chat-float" style="height: auto;">
                <div class="channel-chat-container">
                    <div class="heading">
                        <div style="display: flex; gap: 10px;">
                            <h4>Actions</h4>
                            <i class="fa fa-cog"></i>
                        </div>
                        <span onclick="minimize()" style="cursor: pointer;"><i class="fa fa-angle-down"></i></span>
                    </div>
                    <div style="display: flex; flex-direction: column;">
                        <button class="btn btn-primary" style="margin-top: 10px; width: 100%;"
                            onclick="actionRedirect('<%= bookmarks %>', 'bookmarks')">
                            <span class="fa fa-bookmark"></span>
                            Bookmarks
                        </button>
                        <button class="btn btn-primary" style="margin-top: 10px; width: 100%;"
                            onclick="actionRedirect('<%= likesArray.length %>', 'likes')">
                            <span class="fa fa-heart"></span>
                            Likes
                        </button>
                    </div>
                </div>
                <div class="button">
                    <div onclick="showChannelchat(this)" style="cursor: pointer;">
                        <i class="fa fa-cog icon-1" style="display: block;"></i>
                        <i class="fa fa-times icon-2" style="display: none;"></i>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!--Theme Customization-->
    <%- include ("./partials/themeCustomization") %> 

    <!-- Updates -->
    <%- include ("./partials/updates") %> 

    <!-- Contact List -->
    <%- include ("./partials/contactList") %>  
    
    <script>
        function showReplies(userID, uniqID, commentID, postID) {
            socket.emit("showReplies", { userID, uniqID, commentID, postID })

            document.querySelector(".feed").style.display = "none"
            document.querySelector(".reply-container").style.display = "block"
        }

        function closeReplies() {
            document.querySelector(".feed").style.display = "block"
            document.querySelector(".reply-container").style.display = "none"
        }

        function likePost(e, userID, postID) {
            var likePostClass = e.classList

            if (likePostClass.contains("fa-heart-o")) {
                e.classList.replace("fa-heart-o", "fa-heart")

                socket.emit("likePost", { userID, postID })

                var successAlert = document.getElementById("alert-success");
                var successAlertIcon = document.querySelector("#alert-success i");
                var successMessage = document.querySelector("#alert-success .msg")

                successAlert.style.display = "block"
                successAlertIcon.className = ""
                successAlertIcon.className = "fa fa-thumbs-up"
                successMessage.textContent = "Liked"

                setTimeout(() => {
                    successAlert.style.display = "none"

                }, 3000)
            } else {
                e.classList.replace("fa-heart", "fa-heart-o")

                socket.emit("unlikePost", { userID, postID })
            }
        }
        function bookmark(e, userID, postID) {
            var bookmarkClass = e.classList

            if (bookmarkClass.contains("fa-bookmark-o")) {
                e.classList.replace("fa-bookmark-o", "fa-bookmark")

                socket.emit("bookmarkPost", { userID, postID })

                var successAlert = document.getElementById("alert-success");
                var successAlertIcon = document.querySelector("#alert-success i");
                var successMessage = document.querySelector("#alert-success .msg")

                successAlert.style.display = "block"
                successAlertIcon.className = ""
                successAlertIcon.className = "fa fa-bookmark"
                successMessage.textContent = "Bookmarked"

                setTimeout(() => {
                    successAlert.style.display = "none"

                }, 3000)
            } else {
                e.classList.replace("fa-bookmark", "fa-bookmark-o")

                socket.emit("unBookmarkPost", { userID, postID })
            }
        }
        function showActionBox3() {
            if (document.querySelector(".box<%= singleFeed._id %>").style.display === "none") {
                document.querySelector(".box<%= singleFeed._id %>").style.display = "block"
            } else {
                document.querySelector(".box<%= singleFeed._id %>").style.display = "none"
            }
        }

        function tagComment(id, user, comment, uniqID) {
            const tagComment = document.querySelector(".tag-comment")
            const commentOwner = document.querySelector(".tag-comment .comment-owner")
            const ownerComment = document.querySelector(".tag-comment .owner-comment")

            tagComment.style.opacity = "1"

            commentOwner.textContent = "replying to @" + user
            ownerComment.textContent = comment


            //Set comment ID into hidden form input 
            var commentForm = document.getElementById("<%= singleFeed._id  %>");

            var commentID = commentForm.querySelector(".commentID")
            var uniqueID = commentForm.querySelector(".uniqID")
            commentID.value = id
            uniqueID.value = uniqID
        }

        function closeTagComment() {
            const tagComment = document.querySelector(".tag-comment")

            const commentOwner = document.querySelector(".tag-comment .comment-owner")
            const ownerComment = document.querySelector(".tag-comment .owner-comment")

            tagComment.style.opacity = "0"

            commentOwner.textContent = ""
            ownerComment.textContent = ""

            //Set comment ID into hidden form input 
            var commentForm = document.getElementById("<%= singleFeed._id  %>");

            var commentIDs = commentForm.querySelector(".commentID")
            var uniqID = commentForm.querySelector(".uniqID")
            commentIDs.value = ""
            uniqID.value = ""
        }

        var successAlert = document.getElementById("alert-success");
        var successAlertIcon = document.querySelector("#alert-success i");
        var successMessage = document.querySelector("#alert-success .msg")
        var dangerAlert = document.getElementById("alert-danger")
        var dangerMessage = document.querySelector("#alert-danger .msg")

        var commentForm = document.getElementById("<%= singleFeed._id  %>");

        commentForm.addEventListener('submit', async (e) => {
            e.preventDefault()

            const className = commentForm.className

            var commentpostID = document.querySelector("." + className + " .postID");
            var commentIDValue = document.querySelector("." + className + " .commentID");
            var uniqIDValue = document.querySelector("." + className + " .uniqID");
            var myComment = document.querySelector("." + className + " .myReply");


            var postID = commentpostID.value
            var commentID = commentIDValue.value
            var myReply = myComment.value
            var user = '<%= user._id %>'
            var username = '<%= user.username %>'
            var userAvatar = '<%= user.avatar %>'
            var uniqID = uniqIDValue.value


            if (myReply != '') {

                myComment.value = ''
                closeTagComment()

                if (commentID) {

                    socket.emit("postMoreComments", { postID, commentID, myReply, user, uniqID })

                    successAlert.style.display = "block"
                    successAlertIcon.className = ""
                    successAlertIcon.className = "fa fa-check-circle"
                    successMessage.textContent = "Your Comment has been sent"

                    setTimeout(() => {
                        successAlert.style.display = "none"

                    }, 3000)

                    var div = document.createElement("div");

                    div.classList.add("under-comments");
                    div.innerHTML = `
    
                                        <span class="user-avatar">
                                            <img src="../../../uploads/${userAvatar}" alt="">
                                        </span>
                                        <span>
                                            <b style="margin-right: 5px;">
                                                ${username}
                                            </b>
                                            ${myReply}
                                        </span>

                                    `;
                    document.querySelector(".comment" + commentID).appendChild(div);

                } else {

                    socket.emit("singlePostComments", { postID, myReply, user })

                    successAlert.style.display = "block"
                    successAlertIcon.className = ""
                    successAlertIcon.className = "fa fa-check-circle"
                    successMessage.textContent = "Your Comment has been sent"

                    setTimeout(() => {
                        successAlert.style.display = "none"

                    }, 3000)

                }
            } else {
                dangerAlert.style.display = "block"
                dangerMessage.textContent = "Field cannot be left blank."

                setTimeout(() => {
                    dangerAlert.style.display = "none"
                }, 5000)
            }

        })

        function submitForm(postID, commentID, uniqID){
            var commentForm2 = document.getElementById("newID"+postID);

            var myComment = document.querySelector("#newID" + postID + " .myReply");

            var myReply = myComment.value
            var user = '<%= user._id %>'
            var username = '<%= user.username %>'
            var userAvatar = '<%= user.avatar %>'

            
            
            if (myReply != '') {
                
                myComment.value = ''
                closeTagComment2()

                socket.emit("postMoreComments", { postID, commentID, myReply, user, uniqID })

                successAlert.style.display = "block"
                successAlertIcon.className = ""
                successAlertIcon.className = "fa fa-check-circle"
                successMessage.textContent = "Your Reply has been sent"

                setTimeout(() => {
                    successAlert.style.display = "none"

                }, 3000)

                    var div = document.createElement("div");

                    div.classList.add("under-comments");
                    div.innerHTML = `
    
                                        <span class="user-avatar">
                                            <img src="../../../uploads/${userAvatar}" alt="">
                                        </span>
                                        <span>
                                            <b style="margin-right: 5px;">
                                                ${username}
                                            </b>
                                            ${myReply}
                                        </span>

                                    `;
                    document.querySelector(".comment2" + commentID).appendChild(div);

            } else {
                dangerAlert.style.display = "block"
                dangerMessage.textContent = "Field cannot be left blank."

                setTimeout(() => {
                    dangerAlert.style.display = "none"
                }, 5000)
            }

        }  

    </script>

    <!--JS Script Attachment-->
    <script src="/socket.io/socket.io.js"></script>
    <script src="../../../js/script.js"></script>
</body>
</html>