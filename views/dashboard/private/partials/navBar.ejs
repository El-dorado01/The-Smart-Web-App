<nav>
    <div class="container">
        <h2 class="logo">Smart Web</h2>
        <div class="search-bar">
            <span class="fa fa-search"></span>
            <input type="search" placeholder="Search through">
        </div>
        <div class="create">
            <a href="/dashboard/public">
                <label class="btn btn-primary" for="switch_lifestyle">Switch Lifestyle</label>
            </a>
            <i class="hide-bar">
                <span class="fa fa-eye hidebar-icon-1" title="Show Bar"></span>
                <span class="fa fa-eye-slash hidebar-icon-2" title="Hide Bar"></span>
            </i>
            <div class="profile-pic">
                <a href="/dashboard/private/profile/<%= user._id %>">
                    <% if(user.avatar){ %>
                        <img src="../../../uploads/<%= user.avatar %>" alt="">
                    <% } else { %>
                        <img src="../../../images/smart.png" alt="">
                    <% } %>
                </a>
            </div>
        </div>
    </div>
</nav>