<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Header -->
    <%- include("../partials/header") %>
</head>

<body>
    <!-- NavBar -->
    <%- include ("../partials/navBar") %>

    <!--Main-->
    <main>
        <div class="container">
            <!-- Sidebar -->
            <%- include ("../partials/sidebar") %>

            <!--Middle-->
            <div class="middle">
                <!--Forums-->
                <div class="messages">
                    <div class="heading" id="forum-heading" onclick="closeTag()" style="margin-bottom: 0.3rem;">
                        <div style="display:flex;">
                            <h4 style="margin-right: 10px;">Forums</h4>
                            <i class="fa fa-users-rays"></i>
                        </div>
                        <i class="fa fa-angle-down angle1"
                            style="display: none; font-size: 18px; padding-right: 10px; cursor: pointer;"></i>
                        <i class="fa fa-angle-left angle2"
                            style="font-size: 18px; padding-right: 10px; cursor: pointer;"></i>
                    </div>
                    <div id="close-forums">
                        <!--Serach Bar-->
                        <div class="search-bar">
                            <i class="fa fa-search"></i>
                            <input type="search" placeholder="Search" id="message-searchs">
                        </div>
                        <div class="scroll-bar">
                            <div class="message">
                                <div class="profile-pic">
                                    <img src="../../../../images/smart.png" alt="">
                                </div>
                                <div class="message-body">
                                    <h5 style="font-size: 13px; font-weight: 600;">Real Matters</h5>
                                    <p class="text-muted">255 members</p>
                                </div>
                            </div>
                            <div class="message">
                                <div class="profile-pic">
                                    <img src="../../../../images/smart.png" alt="">
                                </div>
                                <div class="message-body">
                                    <h5 style="font-size: 13px; font-weight: 600;">Quick Invasion of Hughes</h5>
                                    <p class="text-muted">1055 members</p>
                                </div>
                            </div>
                            <div class="message">
                                <div class="profile-pic">
                                    <img src="../../../../images/smart.png" alt="">
                                </div>
                                <div class="message-body">
                                    <h5 style="font-size: 13px; font-weight: 600;">What a woman does in her...</h5>
                                    <p class="text-muted">12 members</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="user-profile-page">
                    <div class="header">
                        <div class="avatar">
                            <img src="../../../../images/5.jpg" alt="">
                        </div>
                        <div class="info">
                            <div class="name">
                                <h3>User Name</h3>
                                <span>Experienced</span>
                            </div>
                            <p>123 posts</p>
                            <p>Joined on 23rd September, 2022.</p>
                            <span style="padding: 5px; background-color: var(--color-light);">Member</span>
                        </div>
                    </div>
                    <div class="profile-body">
                        <div class="category">
                            <h6 class="active tablinks" class="archive" onclick="openTab(event, 'recent-activity')"
                                id="defaultOpen">Recent Activity &nbsp; <i class="fa-solid fa-chart-simple"></i></h6>
                            <h6 class="tablinks" onclick="openTab(event, 'rank-progress')">Rank Progress &nbsp; <i
                                    class="fa-solid fa-ranking-star"></i></h6>
                        </div>
                        <div class="postFeeds" id="recent-activity">
                            <% 
                            // Check if there's any activity on user's profile
                                if(recentActivities.activities.length > 0){ 
                                    for (let i = 0; i < recentActivities.activities.length; i++) {
                                        const activity = recentActivities.activities[i];
                                        if(activity.activity == "post"){%>
                            <a
                                href="/dashboard/public/forum/<%= activity.forumID %>/key?topicID=<%= activity.topicID %>">
                                <div class="activity">
                                    <span class="activity-icon"><i class="fa-solid fa-paper-plane fa-lg"></i></span>
                                    <span class="activity-details">User created a new topic in the forum </span>
                                    <span
                                        class="activity-time"><%= new Date(activity.datePerformed).toDateString() %></span>
                                </div>
                            </a>
                            <%}else if(activity.activity == "response"){%>
                            <a
                                href="/dashboard/public/forum/<%= activity.forumID %>/key?topicID=<%= activity.topicID %>#<%= activity.responseID %>">
                                <div class="activity">
                                    <span class="activity-icon"><i class="fa-solid fa-comment fa-lg"></i></span>
                                    <span class="activity-details">User commented on a topic</span>
                                    <span
                                        class="activity-time"><%= new Date(activity.datePerformed).toDateString() %></span>
                                </div>
                            </a>
                            <%}else if(activity.activity == "upvoteTopic"){%>
                            <a
                                href="/dashboard/public/forum/<%= activity.forumID %>/key?topicID=<%= activity.topicID %>">
                                <div class="activity">
                                    <span class="activity-icon"><i class="fa-solid fa-circle-up fa-lg"></i></span>
                                    <span class="activity-details">User upvoted a topic</span>
                                    <span
                                        class="activity-time"><%= new Date(activity.datePerformed).toDateString() %></span>
                                </div>
                            </a>
                            <%}else{%>
                            <a
                                href="/dashboard/public/forum/<%= activity.forumID %>/key?topicID=<%= activity.topicID %>#<%= activity.responseID %>">
                                <div class="activity">
                                    <span class="activity-icon"><i class="fa-solid fa-circle-up fa-lg"></i></span>
                                    <span class="activity-details">User upvoted a response on a topic</span>
                                    <span
                                        class="activity-time"><%= new Date(activity.datePerformed).toDateString() %></span>
                                </div>
                            </a>
                            <%}
                                    }
                                    %>
                            <%}else{%>
                            <div class="body"
                                style="display: flex; align-items: center; justify-content: center; font-size: 1.2rem; height: 50vh;">
                                <span class="text-muted">No recent activity</span>
                            </div>
                            <%}%>
                        </div>
                        <div class="postFeeds" id="rank-progress">B</div>
                    </div>
                </div>

                <%- include ("./topic_category_middle") %>
                            <!--Forum box end here-->
                        </div>
                        <!--Right-->
                        <div class="right">
                            <!--Forums-->
                            <%- include ("./my_forums_right") %>
                            <!--Forums end here-->

                            <!-- ===============FORUM PROFILE=========================== -->
                            <%- include ("./my_profile") %>
                            <!-- ===============FORUM PROFILE ENDS HERE=========================== -->

                            <!--Forum box-->
                            <%- include ("./topic_category_right") %>
                            <!--Forum box end here-->
                        </div>
    </main>

    <!--Theme Customization-->
    <%- include ("../partials/themeCustomization") %>

    <!--JS Script Attachment-->
    <script src="/socket.io/socket.io.js"></script>
    <script src="../../../../js/script.js"></script>
</body>

</html>