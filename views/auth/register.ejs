<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="../images/smart.ico" type="image/x-icon">
    <title>Smart Web App - Begin Adventure</title>

    <!--Google fontawesome-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Slab:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet"> 
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital@0;1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500&display=swap" rel="stylesheet"> 
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Mono:ital@0;1&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Convergence&display=swap" rel="stylesheet">

    <!--Font awesome icon link-->
    <script src="https://kit.fontawesome.com/02e26faee8.js" crossorigin="anonymous"></script>
    

    <!--Bootstrap link-->
    <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">

    <!-- Optional theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous">

    <!-- Latest compiled and minified JavaScript -->
    <!--<script src="https://cdn.jsdelivr.net/npm/bootstrap@3.3.7/dist/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>-->
    

    <!--Main CSS file-->
    <link rel="stylesheet" href="../css/form-style.css">
</head>
<body>
    <div class="form-container">
        <!--=====================Alerts=====================-->
        <div class="alerts">
            <div class="alert-success" id="alert-success" style="display: none;">
                <!-- <span class="fa fa-times"></span> -->
                <div class="body">
                    <i class="fa fa-check-circle"></i>
                    <p class="msg"><%# successMsg %></p>
                </div>
            </div>
            <div class="alert-danger" id="alert-danger" style="display: none;">
                <!-- <span class="fa fa-times"></span> -->
                <div class="body">
                    <i class="fa fa-exclamation-circle"></i>
                    <p class="msg"></p>
                </div>
            </div>
        </div> 
        <!--=======================Alerts End Here========================-->
        <div class="form-wrapper sign-up">
            <div class="banner">
                <h1><img src="../images/smart.png" alt=""> Smart Web</h1>
                <p>Enter your details and begin your adventure with us</p>
            </div>
            <div class="brown-bg">
                <a href="/auth/login">
                    <button>Resume Adventure</button>
                </a>
            </div>
            <form class="signup-form">
                <h1>Begin Adventure</h1>
                <div class="social-media">
                    <i class="fab fa-facebook-f"></i>
                    <i class="fab fa-instagram"></i>
                    <i class="fab fa-twitter"></i>
                </div>
                <p>or use your email for registration</p>
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" placeholder="Username" name="username" class="username"  maxlength="20">
                    <span class="focus-input"></span>
                </div>
                <div class="input-group">
                    <i class="fas fa-envelope"></i>
                    <input type="email" placeholder="Email" name="email" class="email" >
                    <span class="focus-input"></span>
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" placeholder="Password" name="password" class="password" >
                    <span class="focus-input"></span>
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" placeholder="Repeat Password" class="repeat-password" >
                    <span class="focus-input"></span>
                </div>
                <b class="resume">Wanna resume your adventure? <a href="/auth/login">Click here.</a></b>
                <button type="submit">Sign Up</button>
            </form>
        </div>
    </div>
    <script>
        const signUpForm = document.querySelector("form");
        const userName = document.querySelector(".signup-form .username")
        const userEmail = document.querySelector(".signup-form .email")
        const userPassword = document.querySelector(".signup-form .password")
        const userRepeatPassword = document.querySelector(".signup-form .repeat-password")
        const successAlert = document.getElementById("alert-success");
        const successMessage = document.querySelector("#alert-success .msg")
        const dangerAlert = document.getElementById("alert-danger")
        const dangerMessage = document.querySelector("#alert-danger .msg")

        signUpForm.addEventListener('submit', async (e)=> {
            e.preventDefault()

            dangerAlert.style.display = 'none'
            dangerMessage.textContent = ''

            const userInfo = {
                username: userName.value,
                email: userEmail.value,
                password: userPassword.value,
                repeatPassword: userRepeatPassword.value
            }

            const {
                username,
                email,
                password,
                repeatPassword
            } = userInfo

            try {

                if(password === repeatPassword) {

                    const response = await fetch("/auth/register", {
                        method: "POST",
                        body: JSON.stringify({username, email, password}),
                        headers: { 'Content-Type': 'application/json' }
                    })

                    const data = await response.json()

                    if(data.msg && data.msg === "A username must be provided,An email must be provided,A password must be provided"){
                        dangerAlert.style.display = "block"
                        dangerMessage.textContent = "Fields cannot be left blank"

                        setTimeout(()=> {
                            dangerAlert.style.display = "none"
                        },5000)
                    } else

                    if(data.msg && data.msg != "A username must be provided,An email must be provided,A password must be provided"){
                        dangerAlert.style.display = "block"
                        dangerMessage.textContent = data.msg

                        setTimeout(()=> {
                            dangerAlert.style.display = "none"
                        },5000)
                    } else {
                        userName.value = ''
                        userEmail.value = ''
                        userPassword.value = ''
                        userRepeatPassword.value = ''

                        successAlert.style.display = "block"
                        successMessage.textContent = "Account created successfully"

                        setTimeout(() => {
                            successAlert.style.display = "none"
                            location.assign(`/emailVerification/send_email/${email}`)
                        },3000)
                    }

                } else {
                    dangerAlert.style.display = "block"
                    dangerMessage.textContent = "Your password does not match"

                    setTimeout(() => {
                        dangerAlert.style.display = "none"
                    },5000)
                }

            } catch (error) {
                console.log(error);
                dangerAlert.style.display = "block"
                dangerMessage.textContent = "An error occurred, please try again"

                setTimeout(() => {
                    dangerAlert.style.display = "none"
                },5000)
            }
        })
    </script>
    <script src="../../js/script.js"></script>
    <!-- <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script> -->
    <!-- <script src="../alert.js"></script> -->
     
</html>