<script>
    var lockMyScreen = '<%= lockScreen %>'
    if (lockMyScreen == "true") {
        window.location.href = "/dashboard/lockscreen"
    }
</script>
<div class="left">
    <a class="profile" href="/dashboard/private/profile/<%= user._id %>">
        <div class="profile-pic">
            <img src="../../../../uploads/<%= user.avatar %>" alt="">
            
        </div>
        <div class="handle">
            <h4><%= user.username %></h4>
            <p class="text-muted">
                @<%= user.username %>
            </p>
        </div>
    </a>

    <!--Sidebar-->
    <div class="sidebar">
        <!-- <a class="menu-item <%# if(page_name === "/" || page_name === "/index"){ %> active <%#}%>" href="/dashboard/private/">
            <span><i class="fa fa-house icon"></i></span> <h3>Home</h3>
        </a> -->
        <!-- <a class="menu-item" id="my-updates">
            <span><i class="fa fa-refresh"></i></span> <h3>My Updates</h3>
        </a>
        <a class="menu-item"id="contact-list">
            <span><i class="fa fa-address-book"></i></span> <h3>Contact List</h3>
        </a> -->
        <a class="menu-item <% if(page_name === "/live_meeting" || (page_name. indexOf('/live_meeting') > -1)){ %> active <%}%>" href="/dashboard/private/live_meeting">
            <span><i class="fa fa-podcast"></i></span> <h3>Live Meeting</h3>
        </a>
        <a class="menu-item <% if(page_name === "/movies" || (page_name. indexOf('/movies') > -1)){ %> active <%}%>" href="/dashboard/private/movies">
            <span><i class="fa fa-film"></i></span> <h3>Smart Movies</h3>
        </a>
        <a class="menu-item <% if(page_name === "/smart_network" || (page_name. indexOf('/smart_network') > -1)){ %> active <%}%> " href="/dashboard/private/smart_network">
