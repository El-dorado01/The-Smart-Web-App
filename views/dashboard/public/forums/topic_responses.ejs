                        %>
<!-- Check if user that posted response is the questionnaire-->
<!--Questionnaire-->
<div class="q-box responseBox_<%= response.response._id %>" id="<%= response.response._id %>">
    <div class="q-box-main">
        <div class="q-box-left">
            <div class="user-info">
                <a href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                    <h4><%= questionnaire.userInfo.username %></h4>
                    </a>
                <a href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                    <img src="../../../../uploads/<%= questionnaire.userInfo.avatar %>" alt="">
                    </a>
                <div class="upvotes"><%= questionnaire.memberUpvotes %>
                    upvote<% if(questionnaire.memberUpvotes > 1){%>s<% } %></div>
                <span>Posted: <i
                        class="text-muted"><%= new Date(response.response.dateReplied).toDateString() %></i></span>
            </div>
        </div>
        <div class="q-box-right" id="field_<%= response.response._id %>">
            <% if(response.response.taggedResponseID != ''){
                                        if (response.response.taggedResponseID == topicInfo._id) { %>
            <div class="tag-statement">
                <div class="statement">
                    <div class="head">
                        <span class="fa fa-angle-down"></span>
                        On <%= new Date(topicInfo.createdAt).toDateString() %>,
                        <%= questionnaire.userInfo.username %> said:
                    </div>
                    <a href="#<%= response.response.taggedResponseID %>">
                        <div class="body">
                            <%- topicInfo.topicText %>
                        </div>
                    </a>
                </div>
            </div>
            <%  } else {
                                            for (let i = 0; i < responses.length; i++) {
                                                const reply = responses[i];
                                                if (response.response.taggedResponseID == reply.response._id) { %>
            <div class="tag-statement">
                <div class="statement">
                    <div class="head">
                        <span class="fa fa-angle-down"></span>
                        On <%= new Date(reply.response.dateReplied).toDateString() %>,
                        <%= questionnaire.userInfo.username %> said:
                    </div>
                    <a href="#<%= response.response.taggedResponseID %>">
                        <div class="body">
                            <%- reply.response.replyText %>
                        </div>
                    </a>
                </div>
            </div>
            <%          }
                                            }
                                        }
                                        %>

            <%} %>
            <div class="field-one">
                <div class="response-field">
                    <%- response.response.replyText %>
                </div>
                <% if(response.response.replyMedia.length > 0){%>
                <div class="media">
                    <% 
                                                var imagesExtensions = ["jpg", "gif", "png"];
                                                var videosExtensions = ["mp4", "3gp", "ogg"];
    
                                                response.response.replyMedia.forEach(media => {
                                                    var url = new URL(media)
                                                    var extension = url.pathname.split(".")[1]
    
                                                    if (imagesExtensions.includes(extension)) { 
                                            %>
                    <div class="img">
                        <img id="forumImg" src="<%= url %>" alt="">
                    </div>
                    <% } else if (videosExtensions.includes(extension)) { %>
                    <div class="video">
                        <video controls>
                            <source src="<%= url %>" type="video/<%= extension %>">
                        </video>
                    </div>
                    <% }
                                                });
                                            %>
                </div>
                <% } %>
            </div>
            <div class="actions">
                <p onclick="tagAResponse('<%= topicInfo.forumID %>', '<%= topicInfo._id %>',
                                            '<%= response.response._id %>',
                                            '<%= JSON.stringify(forumInfo.wordsFilter) %>', <%= isAMember %>)">
                    <i class="fa-solid fa-quote-right fa-lg"></i></p>
                <% if(responsesUpvoted.includes(response.response._id)){%>
                    <p style="width: 40px;" title="Remove this Response from Upvotes" onclick="updateResponseUpvotes(this, '<%= user._id %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= topicInfo.forumID %>','removeResponseFromUpvotes', <%= isAMember %>)">
                        <span class="icon" style="color: var(--color-primary);"><i class="fa-solid fa-circle-up fa-lg"></i></span><span class="count"><%= response.response.upvotes %></span>
                    </p>
                <%}else{%>
                    <p style="width: 40px;" title="Upvote this Response" onclick="updateResponseUpvotes(this, '<%= user._id %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= topicInfo.forumID %>','upvoteAResponse', <%= isAMember %>)">
                        <span class="icon"><i class="fa-solid fa-circle-up fa-lg"></i></span><span class="count"><%= response.response.upvotes %></span>
                    </p>
                <%} %>
                <p title="Share"><i class="fa-solid fa-arrow-up-from-bracket fa-lg"></i> </p>
                <% 
                if(response.response.userID == user._id){
                %>
                <p><i class="fa-solid fa-ellipsis fa-lg"></i></p>
                <p style="background-color: var(--color-danger);" title="Delete"
                    onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                    <i class="fa-solid fa-trash fa-lg"></i>
                </p>
                <% }else if(forumInfo.creator == user._id){ %>
                <p style="background-color: var(--color-danger);" title="Delete"
                    onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                    <i class="fa-solid fa-trash fa-lg"></i> </p>
                <%} else { 
                        for (let i = 0; i < forumInfo.moderators.length; i++) { if
                            (forumInfo.moderators[i].userID==user._id ) { %>
                <p style="background-color: var(--color-danger);" title="Delete"
                    onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                    <i class="fa-solid fa-trash fa-lg"></i> </p>

                <% }
                        }
                    }%>
            </div>
        </div>
    </div>
</div>
<% }else{ %>
