<div class="add-topic-modal">
    <div class="card">
        <div class="close-topic" onclick="closeTopicModalTwo()" style="cursor: pointer;">
            <span class="fa fa-times"></span>
        </div>
        <h3>Add a New Topic</h3>
        <!-- Subjects, topicText, topicMedia, userID, forumID -->
        <div class="post-area">
            <div class="field">
                <label for="subject">Subject</label>
                <input type="text" id="subjectTopic" placeholder="Subject" required>
            </div>
            <!-- <label for="standard-select">Standard Select</label>
            <div class="select">
                <select id="standard-select">
                    <option value="Option 1">Text</option>
                    <option value="Option 2">Code Block</option>
                    <option value="Option 3">Blockquote</option>
                </select>
                <span class="focus"></span>
            </div> -->
            <div class="field">
                <label for="tag-value">Tags (While you can select a maximum of five tags, you can add words separated
                    with comma
                    and press enter key)</label>
                <div class="word-tags">
                    <div class="up"></div>
                    <div class="down">
                        <textarea name="" id="tag-value"></textarea>
                    </div>
                </div>
            </div>
            <div class="field">
                <label for="editor">Your message</label>
                <textarea name="" required id="editor" placeholder="Type your message here (in details) ..."></textarea>
            </div>
            <div id="field_1234" class="field">
                <div class="preview"></div>
            </div>
            <div class="actions">
                <div class="icons">
                    <span onclick="createTopicImg('1234')" title="Add Images"><i class="fa-regular fa-image"></i></span>
                    <span onclick="createTopicVideo('1234')" title="Add Video"><i class="fa-solid fa-video"></i></span>
                    <!--<span title="Add File"><i class="fa-solid fa-paperclip"></i></span>-->
                </div>
            </div>
        </div>
    </div>
</div>
<script src="../../../../build/ckeditor.js"></script>
<script>
    let myCoolEditor;

    let topicImgFilesObj = {
        fileArray_1234: [],
    };
    let topicVideoFilesObj = {
        fileArray_1234: [],
    };

    const addTopicModal = document.querySelector(".add-topic-modal");

    const closeTopicModal = (e) => {
        if (e.target.classList.contains("add-topic-modal")) {
            if (myCoolEditor.getData() != "") {
                if (confirm("Discard this topic?")) {
                    document.getElementById("subjectTopic").value = ""
                    myCoolEditor.setData('')
                    //Remove all tags
                    if (document.querySelectorAll(".field .word-tags .up .tag")) {
                        document.querySelectorAll(".field .word-tags .up .tag").forEach(tag => {
                            tag.remove()
                        })
                    }
                    var field = document.querySelector("#field_1234");
                    //Remove all image and video previews
                    if (field.querySelector(".preview .sub-img")) {
                        field.querySelectorAll(".preview .sub-img").forEach((item) => {
                            item.remove();
                        });
                    } else if (field.querySelector(".preview .sub-video")) {
                        field.querySelector(".preview .sub-video").remove();
                    }
                    addTopicModal.style.display = "none";
                }
            } else {
                document.getElementById("subjectTopic").value = ""
                //Remove all tags
                if (document.querySelectorAll(".field .word-tags .up .tag")) {
                    document.querySelectorAll(".field .word-tags .up .tag").forEach(tag => {
                        tag.remove()
                    })
                }
                var field = document.querySelector("#field_1234");
                //Remove all image and video previews
                if (field.querySelector(".preview .sub-img")) {
                    field.querySelectorAll(".preview .sub-img").forEach((item) => {
                        item.remove();
                    });
                } else if (field.querySelector(".preview .sub-video")) {
                    field.querySelector(".preview .sub-video").remove();
                }
                addTopicModal.style.display = "none";
            }
        }

    };
    addTopicModal.addEventListener("click", closeTopicModal);

    function closeTopicModalTwo() {
        if (myCoolEditor.getData() != "") {
            if (confirm("Discard this topic?")) {
                document.getElementById("subjectTopic").value = ""
                myCoolEditor.setData('')
                //Remove all tags
                if (document.querySelectorAll(".field .word-tags .up .tag")) {
                    document.querySelectorAll(".field .word-tags .up .tag").forEach(tag => {
                        tag.remove()
                    })
                }
                var field = document.querySelector("#field_1234");
                //Remove all image and video previews
                if (field.querySelector(".preview .sub-img")) {
                    field.querySelectorAll(".preview .sub-img").forEach((item) => {
                        item.remove();
                    });
                } else if (field.querySelector(".preview .sub-video")) {
                    field.querySelector(".preview .sub-video").remove();
                }
                addTopicModal.style.display = "none";
            }
        } else {
            document.getElementById("subjectTopic").value = ""
            //Remove all tags
            if (document.querySelectorAll(".field .word-tags .up .tag")) {
                document.querySelectorAll(".field .word-tags .up .tag").forEach(tag => {
                    tag.remove()
                })
            }
            var field = document.querySelector("#field_1234");
            //Remove all image and video previews
            if (field.querySelector(".preview .sub-img")) {
                field.querySelectorAll(".preview .sub-img").forEach((item) => {
                    item.remove();
                });
            } else if (field.querySelector(".preview .sub-video")) {
                field.querySelector(".preview .sub-video").remove();
            }
            addTopicModal.style.display = "none";
        }
    }

    function submitForumTopic(forumID, arrayValue) {
        const filterArray = JSON.parse(arrayValue)

        var valuesArray = [];
        var unwantedWords = []
        var invalidWordsPresent = false

        var subject = document.getElementById("subjectTopic").value
        var topicText = myCoolEditor.getData()

        var splitTexts = topicText.split(/[ ,.?]/)
        for (let i = 0; i < splitTexts.length; i++) {
            const text = splitTexts[i];
            if (filterArray.includes(text)) {
                unwantedWords.push(text)
                invalidWordsPresent = true
            }
        }

        if (invalidWordsPresent) {
            dangerAlert.style.display = "block";
            if (unwantedWords.length > 1) {
                dangerMessage.textContent = "These words [" + unwantedWords.toString() +
                    "] are not allowed in this forum";
            } else {
                dangerMessage.textContent = "This word [" + unwantedWords.toString() + "] is not allowed in this forum";
            }

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else {
            var tags = document.querySelectorAll(".field .word-tags .up .tag")
            if (tags.length > 0) {
                const formData = new FormData();
                var topicTags = []
                for (let i = 0; i < tags.length; i++) {
                    const tag = tags[i];
                    var tagValue = tag.querySelector("p").innerText
                    topicTags.push(tagValue)
                }

                if (subject == "" || topicText == "") {
                    dangerAlert.style.display = "block";
                    dangerMessage.textContent = "All fields must be filled!";

                    setTimeout(() => {
                        dangerAlert.style.display = "none";
                    }, 5000);
                } else {
                    var field = document.querySelector("#field_1234");

                    var theID = "1234";
                    var fileKeyArray = [];;
                    var abc = "fileArray_" + theID;

                    if (field.querySelector(".preview .sub-img")) {
                        for (let key = 0; key < topicImgFilesObj[abc].length; key++) {
                            fileKeyArray.push(topicImgFilesObj[abc][key].id);
                            formData.append(topicImgFilesObj[abc][key].id, topicImgFilesObj[abc][key].file);
                        }
                        var fieldObj = {
                            files: fileKeyArray,
                        };
                        valuesArray.push(fieldObj);
                    } else if (field.querySelector(".preview .sub-video")) {
                        fileKeyArray.push(topicVideoFilesObj[abc][0].id);
                        formData.append(topicVideoFilesObj[abc][0].id, topicVideoFilesObj[abc][0].file);

                        var fieldObj = {
                            files: fileKeyArray,
                        };
                        valuesArray.push(fieldObj);
                    }

                    //Set input values to empty
                    document.getElementById("subjectTopic").value = ""
                    myCoolEditor.setData('')
                    //Remove all tags
                    document.querySelectorAll(".field .word-tags .up .tag").forEach(tag => {
                        tag.remove()
                    })
                    //Remove all image and video previews
                    if (field.querySelector(".preview .sub-img")) {
                        field.querySelectorAll(".preview .sub-img").forEach((item) => {
                            item.remove();
                        });
                    } else if (field.querySelector(".preview .sub-video")) {
                        field.querySelector(".preview .sub-video").remove();
                    }


                    addTopicModal.style.display = "none";

                    primaryAlert.style.display = "block";
                    primaryMessage.textContent = "Processing your post, please wait!";

                    formData.append("forumID", forumID);
                    formData.append("subject", subject);
                    formData.append("topicText", topicText);
                    formData.append("newTopicTags", topicTags);
                    formData.append("topicMediaFiles", JSON.stringify(valuesArray));

                    fetch("/dashboard/public/createATopic", {
                            method: "POST",
                            mode: "cors",
                            cache: "no-cache",
                            credentials: "same-origin",
                            redirect: "follow",
                            referrerPolicy: "no-referrer",
                            body: formData,
                        })
                        .then(function (res) {
                            return res.json();
                        })
                        .then(function (json) {
                            if (json.success) {
                                primaryAlert.style.display = "none";
                                successAlert.style.display = "block";
                                successAlertIcon.className = "";
                                successAlertIcon.className = "fa fa-check-circle";
                                successMessage.textContent = json.msg;

                                setTimeout(() => {
                                    successAlert.style.display = "none";
                                    const topicInfo = json.topicInfo;
                                    location.assign("/dashboard/public/forum/" + topicInfo.forumID +
                                        "/key?topicID=" +
                                        topicInfo._id);
                                }, 3000);
                            } else {
                                dangerAlert.style.display = "block";
                                dangerMessage.textContent = json.msg;

                                setTimeout(() => {
                                    dangerAlert.style.display = "none";
                                }, 5000);
                            }
                        })
                        .catch(function (err) {
                            console.log(err);
                        });
                }
            } else {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You must enter at least one tag for your topic!";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            }

        }

    }

    ClassicEditor
        .create(document.querySelector('#editor'), {
            toolbar: {
                // items: [
                //     'heading',
                //     '|',
                //     'bold',
                //     'italic',
                //     'underline',
                //     'strikethrough',
                //     'superscript',
                //     'subscript',
                //     '|',
                //     'horizontalLine',
                //     'link',
                //     'bulletedList',
                //     'numberedList',
                //     '|',
                //     'code',
                //     'codeBlock',
                //     'blockQuote',
                //     '|',
                //     'outdent',
                //     'indent',
                //     '|',
                //     'undo',
                //     'redo'
                // ],
                shouldNotGroupWhenFull: true
            },
        })
        .then(editor => {
            myCoolEditor = editor;
        })
        .catch(error => {
            console.error(error);
        });

    function createTopicImg(id) {
        var field = document.getElementById("field_" + id);

        //Count Number of images
        if (field.querySelector(".preview .sub-img")) {
            var imgNo = field.querySelectorAll(".preview .sub-img").length;
        } else {
            var imgNo = 0;
        }

        if (field.querySelector(".preview .sub-video")) {
            // Can't select more than a video
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select a video with images";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else if (imgNo > 2) {
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select more than two images";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else {
            var remainder = 2 - imgNo;
            let randID = Math.random() * 10;

            var img = document.createElement("input");
            img.setAttribute("type", "file");
            img.setAttribute("onchange", "showTopicImg(this, " + id + ")");
            img.className = remainder;
            img.setAttribute("style", "display: none;");
            img.accept = "image/*";
            img.id = randID;
            img.multiple = true;

            field.appendChild(img);
            // field.querySelector(".preview").appendChild(div)

            var image = document.getElementById(randID);

            image.click();
        }
    }

    function showTopicImg(image, fieldID) {
        var abc = "fileArray_" + fieldID;

        var remainder = parseInt(image.className);
        if (image.files.length > 0 && image.files.length <= remainder) {
            var field = document.getElementById("field_" +
                fieldID);
            for (let i = 0; i < image.files.length; i++) {
                let randID = Math.random() * 10;
                var
                    div = document.createElement("div");
                div.className = "sub-img";
                div.setAttribute("style", "display: none;");
                div.id = "topicImgPreview_" + randID;
                div.innerHTML = ` <span onclick="removeTopicImg('${randID}', '${fieldID}')"><i
            class="fa fa-times"></i></span>
        <img src="" alt="">
        `;

                if (image.files[i].size > 7000000) {
                    dangerAlert.style.display = "block";
                    dangerMessage.textContent = "File size is too big";

                    setTimeout(() => {
                        dangerAlert.style.display = "none";
                    }, 5000);
                } else {
                    var obj = {
                        id: randID,
                        file: image.files[i],
                    };

                    topicImgFilesObj[abc].push(obj);

                    field.querySelector(".preview").appendChild(div);

                    var src = URL.createObjectURL(image.files[i]);
                    var preview = document.getElementById("topicImgPreview_" + randID);
                    preview.style.display = "block";
                    preview.querySelector("img").src = src;
                }
            }
        } else {
            if (image.files.length < 1) {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You didn't select any image file";
                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            } else {
                //Can't select more than 2
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You can't select more than two images";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            }
        }
    }

    function removeTopicImg(id, inputID) {
        var abc = "fileArray_" + inputID;

        for (var i = 0; i < topicImgFilesObj[abc].length; i++) {
            if (topicImgFilesObj[abc][i].id.toString() === id) {
                topicImgFilesObj[abc].splice(i, 1);
            }
        }
        document.getElementById("topicImgPreview_" + id).remove();
    }

    function
    createTopicVideo(id) {
        var field = document.getElementById("field_" + id);
        if (field.querySelector(".preview .sub-img")) { // Can't select a video with images
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select a video with images";
            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else if (field.querySelector(".preview .sub-video")) {
            // var imgNo = field.querySelectorAll(".preview .sub-img").length;
            // Can't select more than a video
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "You can't select more than a video";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        } else {
            // var remainder = 4 - imgNo;
            let randID = Math.random() * 10;

            var video = document.createElement("input");
            video.setAttribute("type", "file");
            video.setAttribute("onchange", "showTopicVideo(this, " + id + ")");
            video.setAttribute("style", "display: none;");
            video.accept = "video/*";
            video.id = randID;

            field.appendChild(video);

            var videoInput = document.getElementById(randID);

            videoInput.click();
        }
    }

    function showTopicVideo(video, fieldID) {
        var abc = "fileArray_" + fieldID;
        let randID = Math.random() * 10;
        var id = video.id;
        // var remainder = parseInt(video.className);
        if (video.files.length > 0) {
            var field = document.getElementById("field_" + fieldID);

            div = document.createElement("div");
            div.className = "sub-video";
            div.setAttribute("style", "display: none;");
            div.id = "videoPreview_" + randID;
            div.innerHTML = ` <span onclick="removeTopicVideo('${randID}', '${fieldID}')"><i
                        class="fa fa-times"></i></span>
                <video src="" controls></video>
                `;

            if (video.files[0].size > 10000000) {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "Video file size is too big";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            } else {
                field.querySelector(".preview").appendChild(div);

                // var duration;
                var src = URL.createObjectURL(video.files[0]);
                var preview = document.getElementById("videoPreview_" + randID);
                preview.style.display = "block";
                preview.querySelector("video").src = src;

                var obj = {
                    id: randID,
                    file: video.files[0],
                };

                topicVideoFilesObj[abc].push(obj);
            }

            //Delete the input type file
            document.getElementById(id).remove();
        } else {
            //Can't select more than 4
            dangerAlert.style.display = "block";
            dangerMessage.textContent = "No video file has been selected";

            setTimeout(() => {
                dangerAlert.style.display = "none";
            }, 5000);
        }
    }

    function removeTopicVideo(id, inputID) {
        var abc = "fileArray_" + inputID;

        for (var i = 0; i < topicVideoFilesObj[abc].length; i++) {
            if (topicVideoFilesObj[abc][i].id.toString() === id) {
                topicVideoFilesObj[abc].splice(i, 1);
            }
        }
        document.getElementById("videoPreview_" + id).remove();
    }

    var tagInput = document.getElementById("tag-value")

    tagInput.addEventListener("keypress", function (event) {
        if (event.key === "Enter") {
            event.preventDefault()

            var valuesArray = tagInput.value.split(",")
            var allTags = document.querySelectorAll(".field .word-tags .up div")
            var allowedNumberOfTags = 5 - allTags.length

            if (valuesArray.length <= allowedNumberOfTags) {
                for (let i = 0; i < valuesArray.length; i++) {
                    var div = document.createElement("div");
                    div.classList.add("tag")
                    div.classList.add(valuesArray[i])
                    div.innerHTML =
                        ` <span class="remove-tag"
                                onclick="removeTagWord('${valuesArray[i]}')">
                                <i class="fa-solid fa-times"></i>
                                </span>
                                <p>${valuesArray[i]}</p>
                            `
                    document.querySelector(".field .word-tags .up").appendChild(div)
                }
                tagInput.value = ""
            } else {
                dangerAlert.style.display = "block";
                dangerMessage.textContent = "You can't enter more than five tags for your topic!";

                setTimeout(() => {
                    dangerAlert.style.display = "none";
                }, 5000);
            }

        }
    })

    function removeTagWord(obj) {
        document.querySelector(".tag." + obj).remove()
    }
    
</script>