<% 
let fontSize = user.themeCustomization.fontSize
let colorTheme = user.themeCustomization.colorTheme 
let background = user.themeCustomization.background
%>

<!--Theme Customization-->
<div class="customize-theme">
    <div class="card">
        <div class="close-theme" style="cursor: pointer;">
            <span class="fa fa-times"></span>
        </div>
        <h2>Customize your view</h2>
        <p class="text-muted">Manage your font-size, color and background</p>

        <!--Font Sizes-->
        <div class="font-size">
            <h4>Font-Size</h4>
            <div>
                <h6>Aa</h6>
                <div class="choose-size">
                    <span class="font-size-1 <% if(fontSize === '10px') {%> active <% } %>"></span>
                    <span class="font-size-2 <% if(fontSize === '13px') {%> active <% } %>"></span>
                    <span class="font-size-3 <% if(fontSize === '15px') {%> active <% } %>"></span>
                    <span class="font-size-4 <% if(fontSize === '17px') {%> active <% } %>"></span>
                </div>
                <h3>Aa</h3>
            </div>
        </div>

        <!--Primary Colors-->
        <div class="color">
            <h4>Color</h4>
            <div class="choose-color">
                <span class="color-1 <% if(colorTheme === 'green') {%> active <% } %>"></span>
                <span class="color-2 <% if(colorTheme === 'yellow') {%> active <% } %>"></span>
                <span class="color-3 <% if(colorTheme === 'purple') {%> active <% } %>"></span>
                <span class="color-4 <% if(colorTheme === 'red') {%> active <% } %>"></span>
                <span class="color-5 <% if(colorTheme === 'blue') {%> active <% } %>"></span>
            </div>
        </div>

        <!--Background Colors-->
        <div class="background">
            <h4>Background</h4>
            <div class="choose-bg">
                <div class="bg-1 <% if(background === 'light') {%> active <% } %>">
                    <span></span>
                    <h5 for="bg-1">Light</h5>
                </div>
                <div class="bg-2 <% if(background === 'dim') {%> active <% } %>">
                    <span></span>
                    <h5 for="bg-2">Dim</h5>
                </div>
                <div class="bg-3 <% if(background === 'dark') {%> active <% } %>">
                    <span></span>
                    <h5 for="bg-3">Dark</h5>
                </div>
            </div>
        </div>
    </div>
</div>