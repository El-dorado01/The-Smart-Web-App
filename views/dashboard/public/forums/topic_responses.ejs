<% // responses.forEach(response=> {
    for (let i = 0; i < responses.length; i++) { const response=responses[i];
        if(response.response.userID==topicInfo.userID){ // } %>
        <!-- Check if user that posted response is the questionnaire-->
        <!--Questionnaire-->
        <div class="q-box responseBox_<%= response.response._id %>" id="<%= response.response._id %>">
            <div class="q-box-main">
                <div class="q-box-left">
                    <div class="user-info">
                        <a
                            href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                            <h4>
                                <%= questionnaire.userInfo.username %>
                            </h4>
                        </a>
                        <a
                            href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= questionnaire.userInfo._id %>">
                            <img src="../../../../uploads/<%= questionnaire.userInfo.avatar %>" alt="">
                        </a>
                        <div class="upvotes">
                            <%= questionnaire.memberUpvotes %>
                                upvote<% if(questionnaire.memberUpvotes> 1){%>s<% } %>
                        </div>
                        <span>Posted: <i class="text-muted">
                                <%= new Date(response.response.dateReplied).toDateString() %>
                            </i></span>
                    </div>
                </div>
                <div class="q-box-right" id="field_<%= response.response._id %>">
                    <% if(response.response.taggedResponseID !='' ){ if
                        (response.response.taggedResponseID==topicInfo._id) { %>
                        <div class="tag-statement">
                            <div class="statement">
                                <div class="head">
                                    <span class="fa fa-angle-down"></span>
                                    On <%= new Date(topicInfo.createdAt).toDateString() %>,
                                        <%= questionnaire.userInfo.username %> said:
                                </div>
                                <a href="#<%= response.response.taggedResponseID %>">
                                    <div class="body">
                                        <%- topicInfo.topicText %>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <% } else { for (let i=0; i < responses.length; i++) { const reply=responses[i]; if
                            (response.response.taggedResponseID==reply.response._id) { %>
                            <div class="tag-statement">
                                <div class="statement">
                                    <div class="head">
                                        <span class="fa fa-angle-down"></span>
                                        On <%= new Date(reply.response.dateReplied).toDateString() %>,
                                            <%= questionnaire.userInfo.username %> said:
                                    </div>
                                    <a href="#<%= response.response.taggedResponseID %>">
                                        <div class="body">
                                            <%- reply.response.replyText %>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <% } } } %>

                                <%} %>
                                    <div class="field-one">
                                        <div class="response-field">
                                            <%- response.response.replyText %>
                                        </div>
                                        <% if(response.response.replyMedia.length> 0){%>
                                            <div class="media">
                                                <% var imagesExtensions=["jpg", "gif" , "png" ]; var
                                                    videosExtensions=["mp4", "3gp" , "ogg" ];
                                                    response.response.replyMedia.forEach(media=> {
                                                    var url = new URL(media)
                                                    var extension = url.pathname.split(".")[1]

                                                    if (imagesExtensions.includes(extension)) {
                                                    %>
                                                    <div class="img">
                                                        <img id="forumImg" src="<%= url %>" alt="">
                                                    </div>
                                                    <% } else if (videosExtensions.includes(extension)) { %>
                                                        <div class="video">
                                                            <video controls>
                                                                <source src="<%= url %>" type="video/<%= extension %>">
                                                            </video>
                                                        </div>
                                                        <% } }); %>
                                            </div>
                                            <% } %>
                                    </div>
                                    <div class="actions">
                                        <span onclick="tagAResponse('<%= topicInfo.forumID %>', '<%= topicInfo._id %>',
                                            '<%= response.response._id %>',
                                            '<%= JSON.stringify(forumInfo.wordsFilter) %>', <%= isAMember %>)">
                                            <i class="fa-solid fa-quote-right fa-lg"></i>
                                        </span>
                                        <% if(responsesUpvoted.includes(response.response._id)){%>
                                            <span style="width: 40px;" title="Remove this Response from Upvotes"
                                                onclick="updateResponseUpvotes(this, '<%= user._id %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= topicInfo.forumID %>','removeResponseFromUpvotes', <%= isAMember %>)">
                                                <strong class="icon" style="color: var(--color-primary);">
                                                    <i class="fa-solid fa-circle-up fa-lg"></i>
                                                </strong>
                                                <strong class="count">
                                                    <%= response.response.upvotes %>
                                                </strong>
                                            </span>
                                            <%}else{%>
                                                <span style="width: 40px;" title="Upvote this Response"
                                                    onclick="updateResponseUpvotes(this, '<%= user._id %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= topicInfo.forumID %>','upvoteAResponse', <%= isAMember %>)">
                                                    <strong class="icon"><i
                                                            class="fa-solid fa-circle-up fa-lg"></i></strong><strong
                                                        class="count">
                                                        <%= response.response.upvotes %>
                                                    </strong>
                                                </span>
                                                <%} %>
                                                    <span title="Share"><i
                                                            class="fa-solid fa-arrow-up-from-bracket fa-lg"></i> </span>
                                                    <% if(response.response.userID==user._id){ %>
                                                        <div style="position: relative;" id="other-actions-<%= response.response._id %>">
                                                            <span title="More"
                                                                onclick="showOtherActionsInForum('<%= response.response._id %>')"><i
                                                                    class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                        </div>
                                                        <!--<span style="background-color: var(--color-danger);"
                                                            title="Delete"
                                                            onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                                                            <i class="fa-solid fa-trash fa-lg"></i>
                                                        </span>-->
                                                        <% }else if(forumInfo.creator==user._id){ %>
                                                            <div style="position: relative;" id="other-actions-<%= response.response._id %>">
                                                                <span title="More"
                                                                    onclick="showOtherActionsInForum('<%= response.response._id %>')"><i
                                                                        class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                            </div>
                                                            <%} else { for (let i=0; i < forumInfo.moderators.length;
                                                                i++) { if (forumInfo.moderators[i].userID==user._id ) {
                                                                %>
                                                                <div style="position: relative;" id="other-actions-<%= response.response._id %>">
                                                                    <span title="More"
                                                                        onclick="showOtherActionsInForum('<%= response.response._id %>')"><i
                                                                            class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                                </div>

                                                                <% } } }%>
                                    </div>
                </div>
            </div>
        </div>
        <% }else{ %>
            <!--Commentators-->
            <div class="c-box responseBox_<%= response.response._id %>">
                <div class="c-box-main">
                    <div class="c-box-left">
                        <div class="user-info">
                            <a
                                href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= response.userInfo._id %>">
                                <h4>
                                    <%= response.userInfo.username %>
                                </h4>
                            </a>
                            <a
                                href="/dashboard/public/member_profile/<%= forumID %>/key?memberID=<%= response.userInfo._id %>">
                                <img src="../../../../uploads/<%= response.userInfo.avatar %>" alt="">
                            </a>
                            <div class="upvotes">
                                <%= response.memberUpvotes %>
                                    upvote<% if(response.memberUpvotes> 1){%>s<% } %>
                            </div>
                            <span>Posted: <i class="text-muted">
                                    <%= new Date(response.response.dateReplied).toDateString() %>
                                </i></span>
                        </div>
                    </div>
                    <div class="c-box-right" id="field_<%= response.response._id %>">
                        <% if(response.response.taggedResponseID !='' ){ if
                            (response.response.taggedResponseID==topicInfo._id) { %>
                            <div class="tag-statement">
                                <div class="statement">
                                    <div class="head">
                                        <span class="fa fa-angle-down"></span>
                                        On <%= new Date(topicInfo.createdAt).toDateString() %>,
                                            <%= questionnaire.userInfo.username %> said:
                                    </div>
                                    <a href="#<%= response.response.taggedResponseID %>">
                                        <div class="body">
                                            <%- topicInfo.topicText %>
                                        </div>
                                    </a>
                                </div>
                            </div>
                            <% } else { for (let i=0; i < responses.length; i++) { const reply=responses[i]; if
                                (response.response.taggedResponseID==reply.response._id) { %>
                                <div class="tag-statement">
                                    <div class="statement">
                                        <div class="head">
                                            <span class="fa fa-angle-down"></span>
                                            On <%= new Date(reply.response.dateReplied).toDateString() %>,
                                                <%= questionnaire.userInfo.username %> said:
                                        </div>
                                        <a href="#<%= response.response.taggedResponseID %>">
                                            <div class="body">
                                                <%- reply.response.replyText %>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                                <% } } } %>

                                    <%} %>
                                        <div class="field-one">
                                            <div class="response-field">
                                                <%- response.response.replyText %>
                                            </div>
                                            <% if(response.response.replyMedia.length> 0){%>
                                                <div class="media">
                                                    <% var imagesExtensions=["jpg", "gif" , "png" ]; var
                                                        videosExtensions=["mp4", "3gp" , "ogg" ];
                                                        response.response.replyMedia.forEach(media=> {
                                                        var url = new URL(media)
                                                        var extension = url.pathname.split(".")[1]

                                                        if (imagesExtensions.includes(extension)) {
                                                        %>
                                                        <div class="img">
                                                            <img id="forumImg" src="<%= url %>" alt="">
                                                        </div>
                                                        <% } else if (videosExtensions.includes(extension)) { %>
                                                            <div class="video">
                                                                <video controls>
                                                                    <source src="<%= url %>"
                                                                        type="video/<%= extension %>">
                                                                </video>
                                                            </div>
                                                            <% } }); %>
                                                </div>
                                                <% } %>
                                        </div>
                                        <div class="actions">
                                            <div onclick="tagAResponse('<%= topicInfo.forumID %>', '<%= topicInfo._id %>',
                                            '<%= response.response._id %>',
                                            '<%= JSON.stringify(forumInfo.wordsFilter) %>', <%= isAMember %>)">
                                                <i class="fa-solid fa-quote-right"></i>
                                            </div>
                                            <% if(responsesUpvoted.includes(response.response._id)){%>
                                                <div style="width: 40px;" title="Remove this Response from Upvotes"
                                                    onclick="updateResponseUpvotes(this, '<%= user._id%>','<%= topicInfo._id %>','<%= response.response._id %>','<%= topicInfo.forumID %>','removeResponseFromUpvotes', <%= isAMember %>)">
                                                    <strong class="icon" style="color: var(--color-primary);"><i
                                                            class="fa-solid fa-circle-up fa-lg"></i></strong><strong
                                                        class="count">
                                                        <%= response.response.upvotes %>
                                                    </strong>
                                                </div>
                                                <%}else{%>
                                                    <div style="width: 40px;" title="Upvote this Response"
                                                        onclick="updateResponseUpvotes(this, '<%= user._id%>','<%= topicInfo._id %>','<%= response.response._id %>','<%= topicInfo.forumID %>','upvoteAResponse', <%= isAMember %>)">
                                                        <strong class="icon"><i
                                                                class="fa-solid fa-circle-up fa-lg"></i></strong><strong
                                                            class="count">
                                                            <%= response.response.upvotes %>
                                                        </strong>
                                                    </div>
                                                    <%} %>
                                                        <div title="Share"><i
                                                                class="fa-solid fa-arrow-up-from-bracket fa-lg"></i>
                                                        </div>
                                                        <% if(response.response.userID==user._id){ %>
                                                            <div title="Delete"
                                                                style="background-color: var(--color-danger);"
                                                                onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                                                                <i class="fa-solid fa-trash fa-lg"></i>
                                                            </div>
                                                            <% }else if(forumInfo.creator==user._id){ %>
                                                                <div title="Delete"
                                                                    style="background-color: var(--color-danger);"
                                                                    onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                                                                    <i class="fa-solid fa-trash fa-lg"></i>
                                                                </div>
                                                                <%} else { for (let i=0; i <
                                                                    forumInfo.moderators.length; i++) { if
                                                                    (forumInfo.moderators[i].userID==user._id ) { %>
                                                                    <div title="Delete"
                                                                        style="background-color: var(--color-danger);"
                                                                        onclick="deleteTopicResponse('<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response._id %>','<%= response.response.userID %>')">
                                                                        <i class="fa-solid fa-trash fa-lg"></i>
                                                                    </div>

                                                                    <% } } }%>
                                        </div>
                    </div>
                </div>
            </div>
            <%} } %>

                <script>
                    function showOtherActionsInForum(id) {
                        var otherActions = document.getElementById("other-actions-" + id)

                        if (!otherActions.querySelector("#action-panel-" + id)) {
                            var div = document.createElement("div")
                            div.innerHTML = `
                    <div class="requote other-actions" style="top: -30%; left:" id="action-panel-${id}">
                        <div class="one" onclick="warnMember()">
                            <i class="fa-solid fa-land-mine-on"></i>
                            <strong>Warn Member</strong>
                        </div>
                        <div class="two" onclick="deleteResponseInForum('${id}')">
                            <i class="fa-solid fa-trash"></i>
                            <strong>Delete Response</strong>
                        </div>
                        <div class="two" onclick="ejectMember('${id}')">
                            <i class="fa-solid fa-user-xmark"></i>
                            <strong>Eject Member</strong>
                        </div>
                    </div>
                    <div class="requote-modal" id="action-modal-${id}" onclick="closeOtherActionsInForum(this, '${id}')"></div>
                `

                            otherActions.appendChild(div)
                        } else {
                            var actionPanel = document.getElementById("action-panel-" + id)
                            var actionModal = document.getElementById("action-modal-" + id)

                            actionPanel.style.display = "block"
                            actionModal.style.display = "block"
                        }
                    }

                    function closeOtherActionsInForum(obj, id) {
                        console.log("Here")
                        var actionPanel = document.getElementById("action-panel-" + id)
                        obj.style.display = "none"
                        actionPanel.style.display = "none"
                    }
                </script>