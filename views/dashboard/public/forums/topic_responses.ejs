                                            '<%= JSON.stringify(forumInfo.wordsFilter) %>')">
                    <i class="fa-solid fa-quote-right"></i> <span>Quote</span></p>
                <p><i class="fa fa-arrow-up"></i><span><%= response.response.upvotes %>
