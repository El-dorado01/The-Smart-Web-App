<% 
                                                    if(isAMember == true){
                                                    if(response.response.userID==user._id){ %>
                                                        <span style="background-color: var(--color-danger);"
                                                            title="Delete"
                                                            onclick="deleteResponseInForum('<%= response.response._id %>','<%= topicInfo.forumID %>','<%= topicInfo._id %>','<%= response.response.userID %>','responseDelete','<%= response.response._id %>')">
                                                            <i class="fa-solid fa-trash fa-lg"></i>
                                                        </span>
                                                        <% }else if(response.response.userID==forumInfo.creator){ %>
                                                            <% }else if(forumInfo.creator==user._id){ %>
                                                                <div style="position: relative;"
                                                                    id="other-actions-<%= response.response._id %>">
                                                                    <span title="More"
                                                                        onclick="showOtherActionsInForum('<%= response.response._id %>', '<%= topicInfo.forumID %>', '<%= response.response.userID %>', '<%= topicInfo._id %>', 'responseDelete', '<%= response.response._id %>')"><i
                                                                            class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                                </div>
                                                                <%} else { for (let i=0; i <
                                                                    forumInfo.moderators.length; i++) { if
                                                                    (forumInfo.moderators[i].userID==user._id ) { %>
                                                                    <div style="position: relative;"
                                                                        id="other-actions-<%= response.response._id %>">
                                                                        <span title="More"
                                                                            onclick="showOtherActionsInForum('<%= response.response._id %>', '<%= topicInfo.forumID %>', '<%= response.response.userID %>', '<%= topicInfo._id %>', 'responseDelete', '<%= response.response._id %>')"><i
                                                                                class="fa-solid fa-ellipsis fa-lg"></i></span>
                                                                    </div>

                                                                    <% } } } }%>