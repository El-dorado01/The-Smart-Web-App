    <!--Main CSS file-->
    <link rel="stylesheet" href="../css/style.css">
</head>
<body>
    <div class="container">
        <!--Header-->
        <div class="header">
            <div class="logo">
                <h1><img src="../images/smart.png" alt=""> <span>Smart Web</span></h1>
                <p>Your social life adventure.</p>
            </div>
        </div>

        <!--Adventure Card-->
        <div class="cards-wrapper">
            <a href="/auth/register" style="display: block; text-decoration: none; cursor:auto;">
                <div class="card-begin">
                    <div class="card-body">
                        <h2>Begin Adventure</h2>
                        <p>Create a new smart account</p>
                        <hr class="card-line">
                    </div>
                    <div class="card-footer">
                        <i class="fa fa-user-plus begin-icon"></i>
                    </div>
                </div>
            </a>
            <a href="/auth/login" style="display: block; text-decoration: none; cursor:auto;">
                <div class="card-resume">
                    <div class="card-body">
                        <h2>Resume Adventure</h2>
                        <p>Login to your smart account</p>
                        <hr class="card-line">
                    </div>
                    <div class="card-footer">
                        <i class="fa fa-sign-in resume-icon"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>
