<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Header -->
    <%- include("./partials/header") %>
</head>

<body>
    <!-- NavBar -->
    <%- include ("./partials/navBar") %>

        <!--Main-->
        <main>
            <div class="body-container">
                <div class="alerts">
                    <div class="alert-success" id="alert-success" style="display: none;">
                        <span class="fa fa-times"></span>
                        <div class="body">
                            <i class="fa fa-check-circle"></i>
                            <p class="msg"></p>
                        </div>
                    </div>
                    <div class="alert-danger" id="alert-danger" style="display: none;">
                        <span class="fa fa-times"></span>
                        <div class="body">
                            <i class="fa fa-exclamation-circle"></i>
                            <p class="msg"></p>
                        </div>
                    </div>
                </div>
                <!-- Sidebar -->
                <%- include ("./partials/sidebar") %>
                    <!--Middle-->
                    <div class="middle">
                        <div class="movies-container">
                            <div class="action-bar">
                                <div class="dots-btn">
                                    <div class="dot dot-1"></div>
                                    <div class="dot dot-2"></div>
                                    <div class="dot dot-3"></div>
                                </div>
                                <div class="nav-menu">
                                    <a href="<%= channelRoute %> " class="nav-menu-link" title="My Channel"><i
                                            class="fa fa-video-camera"></i></a>
                                    <a href="/dashboard/private/movies/myPlaylists" class="nav-menu-link" title="Playlists"><i
                                            class="fa fa-play-circle-o"></i></a>
                                    <a href="/dashboard/private/movies/uploadVideo" class="nav-menu-link" title="Upload Video"><i
                                            class="fa fa-upload"></i></a>
                                </div>
                            </div>
                            <div class="channel-body">
                                <div class="channel-details">
                                    <img id="img-preview" src="<%= channel.logo %>" alt="">
                                    <div>
                                        <span id="showChannelName">
                                            <%= channel.channelName %>
                                        </span>
                                        <i class="fa fa-dot-circle-o"></i>
                                        <span>
                                            <%= myMovies.length %> Video<% if(myMovies.length> 1){ %>s<% } %>
                                        </span>
                                    </div>
                                    <h3 style="margin-top: 10px;"><span id="no_subscribers">
                                            <%= channel.subscribers.length %>
                                        </span> Subcriber<% if(channel.subscribers.length> 1){ %>s<% } %>
                                    </h3>
                                    <p id="showChannelDescription" class="text-muted"
                                        style="width: 65%; margin-top: 10px; display: flex; align-items: center; justify-content: center;">
                                        <%= channel.channelDescription %>
                                    </p>
                                    <% if(!channelAccess){ %>
                                        <button
                                            class="btn <% if(subscribersArray.includes(user._id.toString())){ %> btn-gray <%}else{%> btn-primary<% } %>"
                                            id="subscribe-btn" onclick="subscribe()" style="margin-top: 10px;">
                                            <% if(subscribersArray.includes(user._id.toString())){ %> Unsubscribe <%}else{%> Subscribe <% } %>
                                        </button>
                                        <% } %>
                                </div>
                                <div class="video-category">
                                    <h3 class="active tablinks" onclick="openTab(event, 'channelVideos')" id="defaultOpen">
                                        <div class="middle-align">
                                            <span style="margin-right: 10px;">Channel Videos</span>
                                            <span class="fa fa-film"></span>
                                        </div>
                                    </h3>
                                    <h3 class="tablinks" onclick="openTab(event, 'channelPlaylist')">
                                        <div class="middle-align">
                                            <span style="margin-right: 10px;">Channel Playlist</span>
                                            <i class="fa fa-play-circle-o"></i>
                                        </div>
                                    </h3>
                                    <% if(channelAccess){ %>
                                        <h3 class="tablinks" onclick="openTab(event, 'editChannel')">
                                            <div class="middle-align">
                                                <span style="margin-right: 10px;">Edit Channel</span>
                                            </div>
                                            <i class="fa fa-edit"></i>
                                        </h3>
                                    <% } %>
                                </div>
                                <div class="postFeeds" id="channelVideos">
                                    <div class="list-container"
                                        style="margin-bottom: 100px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); grid-row-gap: 30px;">
                                        <% myMovies.forEach(movie=> { %>
                                            <div class="vid-list2" style="margin-bottom: 0; padding-bottom: 0;">
                                                <div class="left-movie" style="margin-bottom: 0; padding-bottom: 0;">
                                                    <a href="/dashboard/private/movies/<%= movie._id %>">
                                                        <div class="movie-thumbnail">
                                                            <img src="<%= movie.thumbnail %>" alt="" />
                                                        </div>
                                                    </a>
                                                    <div class="movie-details" style="margin-bottom: 0; padding-bottom: 0;">
                                                        <div class="vid-info">
                                                            <a href="/dashboard/private/movies/<%= movie._id %>">
                                                                <%= movie.title %>
                                                            </a>
                                                            <p>
                                                                <%= movie.channel %>
                                                            </p>
                                                            <p><%= movie.views.length %> view<% if(movie.views.length> 1){ %>s<% } %> &bull; <% var timeInMS=new Date() - new Date(movie.createdAt); var secs=timeInMS / 1000; var mins=timeInMS / (1000 * 60); var
                              hours=timeInMS / (1000 * 60 * 60); var days=timeInMS / (1000 * 60 * 60 * 24); var weeks=timeInMS / (1000 * 60 * 60 *
                              24 * 7); if( days> 13.999){ %>
                              <%= Math.round(weeks) %> weeks
                               <% }else if( days> 6.999){ %>
                                <%= Math.round(weeks) %> week
                                  <% }else if( hours> 35.99){ %>
                                    <%= Math.round(days) %> days
                                      <% }else if( hours> 23.99){ %>
                                        <%= Math.round(days) %> day
                                          <% }else if(mins> 119) { %>
                                            <%= Math.round(hours) %> hrs
                                              <% }else if(mins> 59) { %>
                                                <%= Math.round(hours) %> hr
                                                  <% }else if(secs> 119){ %>
                                                    <%= Math.round(mins) %> mins
                                                      <% }else if(secs> 59){ %>
                                                        <%= Math.round(mins) %> min
                                                          <% }else{ %>
                                                            <%= Math.round(secs) %> secs
                                                              <% } %>
                                                                ago</p>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div style="cursor: pointer; margin-bottom: 0; padding-bottom: 0;" class="action"
                                                    onclick="showActionBox('<%= movie._id %>')">
                                                    <span class="fa fa-ellipsis-vertical"></span>
                                                </div>
                                                <div style="margin-bottom: 0; padding-bottom: 0;" class="action-box box<%= movie._id %>">
                                                    <div>
                                                        <i class="fa fa-share"></i>
                                                        <span>Share Video</span>
                                                    </div>
                                                    <div onclick="copyVideoLink('<%= getURL %>/dashboard/private/movies/<%= movie._id %>', '<%= movie._id %>', 'box1')">
                                                        <i class="fa fa-clipboard"></i>
                                                        <span>Copy Link</span>
                                                    </div>
                                                    <% if(!channelAccess){ %>
                                                        <div onclick="videoSpace3('<%= movie._id %>')">
                                                            <i class="fa fa-video-camera"></i>
                                                            <span>Add to Playlist </span>
                                                        </div>
                                                        <% } %>
                                                            <% if(channelAccess){ %>
                                                                <div onclick="videoSpace2('<%= movie._id %>')">
                                                                    <i class="fa fa-video-camera"></i>
                                                                    <span>Add to Playlist</span>
                                                                </div>
                                                                <div>
                                                                    <a href="/dashboard/private/editMovie/<%= movie._id %>">
                                                                        <i class="fa fa-edit"></i>
                                                                        <span>Edit Video Info</span>
                                                                    </a>
                                                                </div>
                                                                <div style="color: var(--color-danger);"
                                                                    onclick="deleteMovies('<%= movie._id %>')">
                                                                    <i class="fa fa-trash"></i>
                                                                    <span>Delete Movie</span>
                                                                </div>
                                                                <% } %>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>
                                <div class="postFeeds" id="channelPlaylist">
                                    <% if(channelAccess) { %>
                                    <button class="btn btn-primary" onclick="space()"> <i class="fa fa-plus"></i> Create Playlist</button>
                                    <% } %>
                                    <div class="list-container" style="margin-bottom: 100px;">
                                        <% channelPlaylists.forEach(playlist=> {
                                            if(playlist.movies.length > 1){
                                            var playlistMovies2 = playlist.movies[playlist.movies.length - 2]
                                            var playlistMovies1 = playlist.movies[playlist.movies.length - 1]
                                            }else
                                            if(playlist.movies.length > 0) var playlistMovies1 = playlist.movies[playlist.movies.length - 1]
                                            %>
                                            <div class="vid-list3<%= playlist._id %>">
                                                <div class="vid-list3" onclick="showPlaylistVideos('<%= playlist._id %>')">
                                                    <div class="thumbnails">
                                                        <% if(playlist.movies.length> 1){ %>
                                                            <img src="<%= playlistMovies1.thumbnail %>" alt="" class="thumbnail-1">
                                                            <img src="<%= playlistMovies2.thumbnail %>" alt="" class="thumbnail-2">
                                                            <% } else if(playlist.movies.length> 0){ %>
                                                                <img src="<%= playlistMovies1.thumbnail %>" alt="" class="thumbnail-1">
                                                                <% } %>
                                                    </div>
                                                    <div class="shadow">
                                                        <span style="color: var(--color-primary);" class="fa fa-play-circle-o"></span>
                                                        <h4 style="color: var(--color-primary);">
                                                            <%= playlist.playlistName %> <br> <span class="text-muted"
                                                                    style="color: var(--color-primary);">
                                                                    <%= playlist.movies.length %> Video<% if(playlist.movies.length> 1){%>s<% }
                                                                                %>
                                                                </span>
                                                        </h4>
                                                    </div>
                                                </div>
                                                <button class="btn" onclick="deletePlaylist('<%= playlist._id %>')"
                                                    style="color: var(--color-danger); margin: 5px 0; width: 100%;"> 
                                                    <i class="fa fa-trash"></i> Delete Playlist
                                                </button>
                                            </div>
                        
                                            <% }) %>
                                    </div>
                                </div>
                                <% if(channelAccess){ %>
                                    <div class="postFeeds" id="editChannel">
                                        <form class="update-channelLogo-form">
                                            <div class="upload-image">
                                                <label class="channel-logo" for="logo">
                                                    <span class="fa fa-camera"></span>
                                                </label>
                                                <input type="file" name="channelLogo" id="logo" style="display: none;" accept="image/*"
                                                    onchange="showPreview(event);">
                                                Upload an image
                                                <button class="btn btn-primary update-logo" style="margin-left: 20px; display: none;">Update
                                                    Logo</button>
                                            </div>
                                        </form>
                                        <form class="update-channel-form">
                                            <div class="input-field">
                                                <span><i class="fa fa-user"></i></span>
                                                <input type="text" name="channelName" id="channel-name" placeholder="Channel Name"
                                                    oninput="showUpdateButton()">
                                            </div>
                                            <div class="input-field-textarea">
                                                <span><i class="fa fa-sticky-note-o"></i></span>
                                                <textarea name="channelDescription" id="channel-description" placeholder="Channel Description"
                                                    oninput="showUpdateButton()"></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary update-channel" style="margin: 10px 0; display: none;">Update
                                                Channel</button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                            
                        </div>
                    </div>
                    <!--Middle ends here-->
            </div>
        </main>

        <!--Theme Customization-->
        <%- include ("./partials/themeCustomization") %>

            <!-- Updates -->
            <%- include ("./partials/updates") %>

                <!-- Contact List -->
                <%- include ("./partials/contactList") %>
        <!--=====================Playlist Modal================-->
        <div class="create-space">
            <div class="card">
                <div class="close-space" onclick="closeSpaceModalTwo()">
                    <span class="fa fa-times" style="cursor:pointer;"></span>
                </div>
                <div class="modal-body">
                    <h3>Create a New Playlist</h3>
                    <form class="space-form space-form2">
                        <div class="input-field">
                            <label for="playlist-name">Name your Playlist <b>*</b></label>
                            <input type="text" id="playlist-name" name="playlist" maxlength="100" placeholder="Playlist Name" required>
                        </div>
                        <button class="btn btn-primary"> <i class="fa fa-plus"></i> Create</button>
                    </form>
                </div>
            </div>
        </div>
        <!--=====================Add Videos to Playlist Modal================-->
        <div class="video-space-modal">
            <div class="card">
                <div class="close-space" onclick="closeVideoSpaceModalTwo2()">
                    <span class="fa fa-times" style="cursor:pointer;"></span>
                </div>
                <div class="modal-body">
                    <h3>Add Video to Playlist</h3>
                    <div class="add-to-playlist">
                        <input type="checkbox" name="checkbox" id="add-to-playlist" onclick="showField()"> <label for="add-to-playlist">Create a new Playlist</label>
                    </div>
                    <form class="space-form space-form3" style="display: none;">
                        <input type="hidden" name="hiddenMovieID" id="hiddenMovieID" value="">
                        <div class="input-field" id="abc">
                            <label for="newplaylist-name">Name your Playlist <b>*</b></label>
                            <input type="text" id="newplaylist-name" name="playlist_name" maxlength="100" placeholder="Playlist Name" required>
                        </div>
                        <button class="btn btn-primary btn-change-2"> <i class="fa fa-plus"></i> Create Playlist and Add
                            Movie</button>
                    </form>
                    <form class="space-form space-form4">
                        <input type="hidden" name="hiddenMovieID" id="hiddenMovieID2" value="">
                        <div class="select-box">
                            <div class="selected" onclick="toggleVideoSpace()">
                                Select a playlist...
                                <span class="fa fa-angle-down angle1"></span>
                                <span class="fa fa-angle-up angle2"></span>
                            </div>
                            <div class="options-container2">
                                <% channelPlaylists.forEach(playlist => { %>
                                <div class="option option<%= playlist._id %>" onclick="updateVideoOption(this)">
                                    <input type="radio" value="<%= playlist._id %>" name="playlist" class="radio">
                                    <label for="<%= playlist.playlistName %>"><%= playlist.playlistName %></label>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: center;">
                            <button class="btn btn-primary btn-change-1"> <i class="fa fa-plus"></i> Add Video</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!--=====================Add Videos to Playlist Modal Two================-->
        <div class="video-space-modal v2-modal">
            <div class="card">
                <div class="close-space" onclick="closeVideoSpaceModalTwo3()">
                    <span class="fa fa-times" style="cursor:pointer;"></span>
                </div>
                <div class="modal-body">
                    <h3>Add Video to Playlist</h3>
                    <div class="add-to-playlist">
                        <input type="checkbox" name="checkbox" id="add-to-playlist2" onclick="showField2()"> <label for="add-to-playlist2">Create a new Playlist</label>
                    </div>
                    <form class="space-form space-form5" style="display: none;">
                        <input type="hidden" name="hiddenMovieID" id="hiddenMovieID3" value="">
                        <div class="input-field" id="abc">
                            <label for="newplaylist-name2">Name your Playlist <b>*</b></label>
                            <input type="text" id="newplaylist-name2" name="playlist_name" maxlength="100" placeholder="Playlist Name" required>
                        </div>
                        <button class="btn btn-primary btn-change-2"> <i class="fa fa-plus"></i> Create Playlist and Add
                            Movie</button>
                    </form>
                    <form class="space-form space-form6">
                        <input type="hidden" name="hiddenMovieID" id="hiddenMovieID4" value="">
                        <div class="select-box">
                            <div class="selected2" onclick="toggleVideoSpace2()">
                                Select a playlist...
                                <span class="fa fa-angle-down angle3"></span>
                                <span class="fa fa-angle-up angle4"></span>
                            </div>
                            <div class="options-container2 options-container-video-forum">
                                <% userPlaylists.forEach(playlist => { %>
                                <div class="option option<%= playlist._id %>" onclick="updateVideoOption2(this)">
                                    <input type="radio" value="<%= playlist._id %>" name="playlist2" class="radio">
                                    <label for="<%= playlist.playlistName %>"><%= playlist.playlistName %></label>
                                </div>
                                <% }) %>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: center;">
                            <button class="btn btn-primary btn-change-1"> <i class="fa fa-plus"></i> Add Video</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- View Channel Scripts -->
        <%- include ("./partials/view_channel_script") %>

        <!--JS Script Attachment-->
        <script src="/socket.io/socket.io.js"></script>
        <script src="../../../js/script.js"></script>
</body>

</html>