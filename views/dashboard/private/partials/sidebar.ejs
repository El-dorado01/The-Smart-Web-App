        </a>
        <a class="menu-item" id="theme">
            <span><i class="fa fa-themeisle"></i></span> <h3>Theme</h3>
        </a>
        <a class="menu-item <% if(page_name === "/settings"){ %> active <%}%>" href="/dashboard/private/settings">
            <span><i class="fa fa-cog"></i></span> <h3>Settings</h3>
        </a>
        <a class="menu-item" onclick="lockScreen('<%= user._id %>')">
            <span><i class="fa fa-lock"></i></span>
            <h3>Lockscreen</h3>
        </a>
        <a class="menu-item">
