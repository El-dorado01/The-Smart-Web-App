    <div class="create-space">
        <div class="card">
            <div class="close-space" onclick="closeSpaceModalTwo()">
                <span class="fa fa-times" style="cursor:pointer;"></span>
            </div>
            <div class="modal-body">
                <h3>Create a space for your forum or followers. Permanent spaces cannot be recorded.</h3>
                <form action="" class="space-form">
                    <div class="input-field">
                        <label for="Name Space">Name your Space <b>*</b></label>
                        <input type="text" name="space" placeholder="What is your space all about?">
                    </div>
                    <div class="select-box">
                        <div class="options-container">
                            <div class="option" onclick="updateOption(this)">
                                <input type="radio" name="spaceFor" class="radio">
                                <label for="everyone">Everyone</label>
                            </div>
                            <div class="option" onclick="updateOption(this)">
                                <input type="radio" name="spaceFor" class="radio" id="myForum">
                                <label for="myForum">My Forum</label>
                            </div>
                            <div class="option" onclick="updateOption(this)">
                                <input type="radio" name="spaceFor" class="radio">
                                <label for="myFollowers">My Followers</label>
                            </div>
                        </div>
                        <div class="selected" onclick="toggleSpace()">
                            This space is for...
                            <span class="fa fa-angle-down angle1"></span>
                            <span class="fa fa-angle-up angle2"></span>
                        </div>
                    </div>
                    <div class="select-box2" id="myForums" style="display: none;">
                        <div class="selected2" onclick="toggleSpace2()">
                            Select a forum you'd like to create a space for...
                            <span class="fa fa-angle-down angle3"></span>
                            <span class="fa fa-angle-up angle4"></span>
                        </div>
                        <div class="options-container options-container2">
                            <div class="option" onclick="updateOption2(this)">
                                <input type="radio" name="forum" class="radio">
                                <label for="Real Matters">Real Matters</label>
                            </div>
                            <div class="option" onclick="updateOption2(this)">
                                <input type="radio" name="forum" class="radio">
                                <label for="Football Only">Football Only</label>
                            </div>
                        </div>
                    </div>
                    <div class="schedule">
                        <input type="date" name="" id="">
                    </div>
                    <div class="modal-action">
                        <div class="input-field">
                            <label for="">
                                <span class="temp">This space is going to be</span> Permanent 
                                <i class="fas fa-question-circle help" onmouseover="displayHelpBox()" onmouseout="undisplayHelpBox()"></i>
                            </label>
                            <input type="checkbox" name="action" id="check" hidden onclick="a()">
                            <label for="check" class="toggle-checkbox">
                                <div class="circle"></div>
                            </label>
                        </div>
                        <div class="input-field">
                            <label for="">Record Space</label>
                            <input type="checkbox" name="action" id="record" hidden onclick="b()">
                            <label for="record" class="toggle-checkbox">
                                <div class="circle"></div>
                            </label>
                        </div>
                    </div>
                    <button class="btn btn-primary">Create</button>
                    <div class="help-box">
                        <span>Recommended for Radio stations and Audio channels</span>
                    </div>
                </form>
            </div>
        </div>
